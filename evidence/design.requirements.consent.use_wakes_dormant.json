      "rust_file": "src/hook.rs",
      "rust_item": "fn[dispatch_plugin_hooks]",
      "text": [
        "/// Dispatch plugin hooks with format routing.",
        "///",
        "/// Accumulates output as `serde_json::Value` in the host agent's wire format.",
        "/// When a plugin's format matches the host agent, input/output pass through directly.",
        "/// When formats differ, conversion goes through symposium canonical types.",
        "/// `prior_context` is the context already in `prior_output`; every hook's",
        "/// context is added to it (see [`JoinedContext`]).",
        "///",
        "/// Returns `Ok(json)` on success, `Err(stderr)` on exit code 2.",
        "#[allow(clippy::too_many_arguments)]",
        "// {impl}`design.requirements.hooks.hook_gating`",
        "// {impl}`design.requirements.hooks.native_input`",
        "// {impl}`design.requirements.hooks.native_output`",
        "// {impl}`design.requirements.hooks.canonical_input`",
        "// {impl}`design.requirements.hooks.canonical_output`",
        "// {impl}`design.requirements.hooks.raw_json_fallback`",
        "// {impl}`design.requirements.hooks.hook_stdin_payload`",
        "// {impl}`design.requirements.hooks.merge_later_wins`",
        "// {impl}`design.requirements.hooks.joined_context`",
        "// {impl}`design.requirements.hooks.deny_final`",
        "// {impl}`design.requirements.hooks.exit_2_stops`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.dormant_inactive`",
        "// {impl}`design.requirements.consent.use_wakes_dormant`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "pub async fn dispatch_plugin_hooks(",
        "    sym: &Symposium,",
        "    host_agent: HookAgent,",
        "    event: HookEvent,",
        "    sym_input: &symposium::InputEvent,",
        "    original_input: &str,",
        "    prior_output: serde_json::Value,",
        "    prior_context: Option<String>,",
        "    deps: &Arc<Workspace>,",
        ") -> Result<serde_json::Value, Vec<u8>> {",
        "    let workspace = deps.info().await.cloned();",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, workspace.as_ref()).await;",
        "",
        "    // Resolving the workspace means running cargo, so only do it when some",
        "    // plugin's hook gating references a concrete crate (a `depends-on(*)`",
        "    // wildcard or env/shell/path predicate never needs the crate graph), or",
        "    // when there is crate-plugin expansion to perform — that too evaluates",
        "    // predicates against the crate graph.",
        "    let dep_ids = if hook_dispatch_needs_deps(sym, &registry.plugins) {",
        "        deps.dep_ids().await.to_vec()",
        "    } else {",
        "        Vec::new()",
        "    };",
        "    let pms = deps.pms();",
        "    let used = workspace",
        "        .as_ref()",
        "        .map(|ws| crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root))",
        "        .unwrap_or_default();",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    // Dispatch over the active set — registry plugins plus crate-sourced ones —",
        "    // so a crate plugin's hooks fire exactly like a registry plugin's.",
        "    let plugins = crate::plugins::active_plugins(",
        "        sym,",
        "        &registry,",
        "        pms,",
        "        workspace.as_ref().map(|ws| ws.root.as_path()),",
        "        &mut ctx,",
        "        symposium_install::UpdateLevel::None,",
        "    )",
        "    .await;",
        "    let hooks = dispatched_hooks_for_payload(&plugins, sym_input, host_agent, &mut ctx);",
        "",
        "    let mut output = prior_output;",
        "    let mut context = JoinedContext::new(event, prior_context);",
        "",
        "    for hook in hooks {",
        "        tracing::info!(",
        "            plugin = %hook.plugin_name,",
        "            hook = %hook.hook_name,",
        "            format = ?hook.format,",
        "            \"running plugin hook\"",
        "        );",
        "",
        "        // Determine stdin for the plugin based on its declared format.",
        "        // After format selection, the only two cases are:",
        "        // - native (matches host agent) → the agent's own payload, byte for byte",
        "        // - symposium → deliver canonical format",
        "        let hook_agent = hook.format.as_agent();",
        "        let stdin_str = if hook_agent == Some(host_agent) {",
        "            original_input.to_string()",
        "        } else {",
        "            match AgentHookInput::to_string(sym_input) {",
        "                Ok(s) => s,",
        "                Err(e) => {",
        "                    tracing::error!(plugin = %hook.plugin_name, hook = %hook.hook_name, error = %e, \"failed to serialize hook input\");",
        "                    continue;",
        "                }",
        "            }",
        "        };",
        "",
        "        let spawn_res = match build_spawn_spec(sym, &hook).await {",
        "            Ok(spec) => spawn_from_spec(spec),",
        "            Err(e) => {",
        "                tracing::warn!(error = %e, \"failed to prepare hook command\");",
        "                continue;",
        "            }",
        "        };",
        "",
        "        match spawn_res {",
        "            Ok(mut child) => {",
        "                if let Some(mut stdin) = child.stdin.take() {",
        "                    let _ = stdin.write_all(stdin_str.as_bytes());",
        "                }",
        "",
        "                let child_out = match child.wait_with_output() {",
        "                    Ok(o) => o,",
        "                    Err(e) => {",
        "                        tracing::warn!(error = %e, \"failed waiting for hook process\");",
        "                        continue;",
        "                    }",
        "                };",
        "",
        "                tracing::trace!(?child_out, \"hook finished\");",
        "",
        "                let exit_code = child_out.status.code();",
        "                tracing::debug!(",
        "                    report = %crate::report::ReportEvent::HookDispatched {",
        "                        plugin: hook.plugin_name.clone(),",
        "                        hook: hook.hook_name.clone(),",
        "                        exit_code,",
        "                        error: None,",
        "                    },",
        "                );",
        "                match exit_code {",
        "                    None | Some(2) => return Err(child_out.stderr),",
        "                    Some(0) if child_out.stdout.is_empty() => continue,",
        "                    Some(0) => {",
        "                        // Parse output and convert to host agent format.",
        "                        // Two cases: native (same as host) or symposium.",
        "                        let host_handler = crate::hook_schema::agent_event(host_agent, event);",
        "                        let Some(host_h) = host_handler else { continue };",
        "",
        "                        let (host_json, hook_output) = if hook_agent == Some(host_agent) {",
        "                            // Native format — parse as host agent output",
        "                            match host_h.parse_output(&child_out.stdout) {",
        "                                Ok(o) => (o.to_hook_output(), Some(o.to_symposium())),",
        "                                Err(e) => {",
        "                                    tracing::warn!(error = %e, \"failed to parse hook output\");",
        "                                    continue;",
        "                                }",
        "                            }",
        "                        } else {",
        "                            // Symposium format — parse and convert to host agent",
        "                            match serde_json::from_slice::<serde_json::Value>(&child_out.stdout) {",
        "                                Ok(v) => {",
        "                                    if let Ok(sym_out) =",
        "                                        serde_json::from_value::<symposium::OutputEvent>(v.clone())",
        "                                    {",
        "                                        let host_out = host_h.translate_output(&sym_out);",
        "                                        (host_out.to_hook_output(), Some(sym_out))",
        "                                    } else if v.is_object() {",
        "                                        (v, None)",
        "                                    } else {",
        "                                        tracing::warn!(",
        "                                            \"hook output is neither an output event nor a JSON object\"",
        "                                        );",
        "                                        continue;",
        "                                    }",
        "                                }",
        "                                Err(e) => {",
        "                                    tracing::warn!(error = %e, \"failed to parse hook output\");",
        "                                    continue;",
        "                                }",
        "                            }",
        "                        };",
        "",
        "                        merge(&mut output, host_json);",
        "                        if hook_output.as_ref().is_some_and(denies) {",
        "                            tracing::info!(",
        "                                plugin = %hook.plugin_name,",
        "                                hook = %hook.hook_name,",
        "                                \"plugin hook denied the tool call; later hooks do not run\"",
        "                            );",
        "                            return Ok(output);",
        "                        }",
        "                        context.add(hook_output.as_ref(), &mut output, host_h.as_ref());",
        "                    }",
        "                    Some(code) => {",
        "                        tracing::warn!(",
        "                            exit_code = code,",
        "                            \"plugin hook exited with non-zero (continuing)\"",
        "                        );",
        "                    }",
        "                }",
        "            }",
        "            Err(e) => {",
        "                tracing::debug!(",
        "                    report = %crate::report::ReportEvent::HookDispatched {",
        "                        plugin: hook.plugin_name.clone(),",
        "                        hook: hook.hook_name.clone(),",
        "                        exit_code: None,",
        "                        error: Some(e.to_string()),",
        "                    },",
        "                );",
        "                tracing::warn!(error = %e, \"failed to spawn hook command\");",
        "            }",
        "        }",
        "    }",
        "",
        "    Ok(output)",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[plugins_entries_match_registry_plugin_names_exactly]",
      "text": [
        "/// A registry plugin's name matches exactly: `use = [\"gateless_plugin\"]`",
        "/// neither wakes the dormant `gateless-plugin` nor is taken for a crate, and",
        "/// `disable = [\"gateless_plugin\"]` does not block it. `auto-enable` is consent",
        "/// for dependencies, so it wakes no registry plugin whatever the spelling.",
        "// {test}`design.requirements.consent.registry_name_exact`",
        "// {test}`design.requirements.consent.auto_enable_dependencies_only`",
        "// {test}`design.requirements.consent.dormant_inactive`",
        "// {test}`design.requirements.consent.use_wakes_dormant`",
        "// {test}`design.requirements.consent.unresolved_use_skipped`",
        "// {test}`design.requirements.enablement.use_disabled_rejected`",
        "#[tokio::test]",
        "async fn plugins_entries_match_registry_plugin_names_exactly() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"dormant-plugin0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "            let woken = || !find_installed_skills(&skills_dir, \"gateless-guidance\").is_empty();",
        "",
        "            ctx.sym.config.plugins.auto_enable = vec![\"gateless-plugin\".into()];",
        "            ctx.sym.config.plugins.used = vec![UseEntry::Global(\"gateless_plugin\".into())];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(!woken(), \"auto-enable and a folded `use` spelling\");",
        "",
        "            ctx.sym.config.plugins.auto_enable.clear();",
        "            ctx.sym.config.plugins.used.clear();",
        "            ctx.sym.config.plugins.disable = vec![\"gateless_plugin\".into()];",
        "            ctx.symposium(&[\"use\", \"gateless-plugin\"]).await?;",
        "            assert!(woken(), \"a folded `disable` spelling\");",
        "",
        "            ctx.symposium(&[\"use\", \"--remove\", \"gateless-plugin\"])",
        "                .await?;",
        "            ctx.sym.config.plugins.disable = vec![\"gateless-plugin\".into()];",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"gateless-plugin\"])",
        "                .await",
        "                .expect_err(\"the exact `disable` spelling blocks it\");",
        "            assert!(err.to_string().contains(\"[plugins] disable\"), \"{err}\");",
        "            assert!(!woken());",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[use_wakes_and_remove_sleeps_a_dormant_plugin]",
      "text": [
        "/// `use` wakes a dormant registry plugin (one no dependency gates), and",
        "/// `--remove` puts it back to sleep, reaping its skills.",
        "// {test}`design.requirements.consent.dormant_inactive`",
        "// {test}`design.requirements.consent.use_wakes_dormant`",
        "// {test}`design.requirements.enablement.use_syncs`",
        "#[tokio::test]",
        "async fn use_wakes_and_remove_sleeps_a_dormant_plugin() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"dormant-plugin0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(find_installed_skills(&skills_dir, \"gateless-guidance\").is_empty());",
        "",
        "            ctx.symposium(&[\"use\", \"gateless-plugin\"]).await?;",
        "            find_installed_skill(&skills_dir, \"gateless-guidance\");",
        "            assert!(read_config(&ctx).contains(\"gateless-plugin\"));",
        "",
        "            ctx.symposium(&[\"use\", \"--remove\", \"gateless-plugin\"])",
        "                .await?;",
        "            assert!(find_installed_skills(&skills_dir, \"gateless-guidance\").is_empty());",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "src/plugins.rs",
      "rust_item": "impl[Plugin]/fn[applies]",
      "text": [
        "    /// Evaluate the plugin-level predicate set, stamping this plugin's",
        "    /// provenance into the context first, so `workspace-member()` sees the",
        "    /// right plugin's provenance. The stamp carries over to the plugin's",
        "    /// nested component evaluations (groups, skills, hooks, MCP servers,",
        "    /// subcommands) on the same context. A dormant plugin",
        "    /// ([`requires_use`](PluginManifest::requires_use)) applies only when an",
        "    /// applicable `[plugins] use` entry names it.",
