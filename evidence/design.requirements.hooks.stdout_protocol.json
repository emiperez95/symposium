      "text": [
        ":::{example} pending_consent",
        "A workspace depends on a crate that ships a plugin the user has not enabled or declined. When an agent starts a session, the `SessionStart` hook names that crate in the agent's context instead of asking, and for every agent that takes JSON its stdout parses as JSON. {cite}`design.requirements.hooks.no_prompt` {cite}`design.requirements.hooks.stdout_protocol`",
        ":::"
      ]
    },
    {
      "rust_file": "src/bin/cargo-agents.rs",
      "rust_item": "fn[prints_reports]",
      "text": [
        "/// Whether the report layer prints events for this command.",
        "///",
        "/// A hook's stdout is the agent's protocol: any report line ahead of the",
        "/// JSON makes the agent discard the whole output. The events still reach",
        "/// the log file; `-v` prints them to stderr when debugging a hook by hand.",
        "// {impl}`design.requirements.hooks.stdout_protocol`",
        "fn prints_reports(is_hook: bool, verbose: bool) -> bool {",
        "    !is_hook || verbose",
        "}"
      ]
    },
    {
      "rust_file": "src/bin/cargo-agents.rs",
      "rust_item": "fn[command_output]",
      "text": [
        "/// The `Output` for this command's human-facing messages.",
        "///",
        "/// Hook commands are quiet (they're invoked by the agent, not the user), so",
        "/// nothing they print reaches the agent's stdout and nothing can prompt.",
        "/// JSON mode also suppresses human output (only JSON goes to stdout).",
        "// {impl}`design.requirements.hooks.no_prompt`",
        "// {impl}`design.requirements.hooks.stdout_protocol`",
        "fn command_output(cli: &Cli, is_hook: bool) -> Output {",
        "    if cli.quiet || is_hook || cli.json {",
        "        Output::quiet()",
        "    } else {",
        "        Output::normal()",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[spawn_from_spec]",
      "text": [
        "// {impl}`design.requirements.hooks.hook_spawn_runnable`",
        "// {impl}`design.requirements.hooks.hook_stdin_payload`",
        "// {impl}`design.requirements.hooks.hook_output_captured`",
        "// {impl}`design.requirements.hooks.stdout_protocol`",
        "// {impl}`design.requirements.hooks.hook_env_path_var`",
        "// {impl}`design.requirements.hooks.hook_env_dir_var`",
        "// {impl}`design.requirements.hooks.hook_env_path_prepend`",
        "fn spawn_from_spec(spec: SpawnSpec) -> std::io::Result<std::process::Child> {",
        "    match spec {",
        "        SpawnSpec::Script { path, args, env } => {",
        "            let mut cmd = Command::new(\"sh\");",
        "            cmd.arg(path).args(args);",
        "            for (k, v) in env {",
        "                cmd.env(k, v);",
        "            }",
        "            cmd.stdin(Stdio::piped())",
        "                .stdout(Stdio::piped())",
        "                .stderr(Stdio::piped())",
        "                .spawn()",
        "        }",
        "        SpawnSpec::Exec { path, args, env } => {",
        "            let mut cmd = Command::new(path);",
        "            cmd.args(args);",
        "            for (k, v) in env {",
        "                cmd.env(k, v);",
        "            }",
        "            cmd.stdin(Stdio::piped())",
        "                .stdout(Stdio::piped())",
        "                .stderr(Stdio::piped())",
        "                .spawn()",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[run]",
      "text": [
        "/// CLI entry point: read payload from stdin, dispatch, print output.",
        "// {impl}`design.requirements.hooks.unsupported_event`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.hooks.hook_trace`",
        "// {impl}`design.requirements.hooks.block_other_exit_2`",
        "// {impl}`design.requirements.hooks.malformed_payload_fails`",
        "// {impl}`design.requirements.hooks.unreadable_payload_succeeds`",
        "pub async fn run(sym: &Symposium, agent: HookAgent, event: HookEvent) -> ExitCode {",
        "    tracing::debug!(\"Running hook listener for agent {agent:?} and event {event:?}\");",
        "",
        "    let mut input = String::new();",
        "    if let Err(e) = std::io::stdin().read_to_string(&mut input) {",
        "        tracing::warn!(?event, error = %e, \"failed to read hook stdin\");",
        "        return ExitCode::SUCCESS;",
        "    }",
        "    tracing::trace!(?input, \"hook stdin\");",
        "",
        "    match execute_hook(sym, agent, event, &input).await {",
        "        Ok(response) => {",
        "            write_hook_trace(agent, event, &input, &response);",
        "            // {impl}`design.requirements.hooks.stdout_protocol`",
        "            if !response.stdout.is_empty() {",
        "                std::io::stdout().write_all(&response.stdout).unwrap();",
        "            }",
        "            if !response.stderr.is_empty() {",
        "                std::io::stderr().write_all(&response.stderr).unwrap();",
        "            }",
        "            ExitCode::from(response.exit_code)",
        "        }",
        "        Err(e) => {",
        "            tracing::warn!(?event, error = %e, \"hook failed\");",
        "            ExitCode::FAILURE",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/installation.rs",
      "rust_item": "fn[run_install_commands]",
      "text": [
        "/// Run a list of post-install shell commands sequentially. Stops at the first",
        "/// failure.",
        "///",
        "/// Their stdout goes to stderr: these commands also run while dispatching a",
        "/// hook, where stdout carries the agent's protocol.",
        "pub async fn run_install_commands(commands: &[String]) -> Result<()> {",
        "    for cmd in commands {",
        "        let status = tokio::process::Command::new(\"sh\")",
        "            .arg(\"-c\")",
        "            .arg(cmd)",
        "            // {impl}`design.requirements.hooks.stdout_protocol`",
        "            .stdout(std::io::stderr())",
        "            .status()",
        "            .await?;",
        "        if !status.success() {",
        "            bail!(\"install command `{cmd}` exited with {status}\");",
        "        }",
        "    }",
        "    Ok(())",
        "}"
      ]
    },
