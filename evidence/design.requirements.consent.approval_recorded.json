{
  "determination": true,
  "inputs": [
    {
      "rust_file": "src/discovery.rs",
      "rust_item": "fn[apply_consent]",
      "text": [
        "/// Record consent decisions: approvals into `[plugins] auto-enable`,",
        "/// declines into `[plugins] disable`, then save the config. Both lists hold",
        "/// dependency crate names, as [`discover`] offers them.",
        "///",
        "/// Split out from the prompt so the decision recording is testable without a",
        "/// terminal, and so other entry points can record the same way.",
        "// {impl}`design.requirements.consent.approval_recorded`",
        "// {impl}`design.requirements.consent.decline_recorded`",
        "// {impl}`design.requirements.consent.consent_confirmed`",
        "pub fn apply_consent(sym: &mut Symposium, approved: &[String], declined: &[String]) -> Result<()> {",
        "    if approved.is_empty() && declined.is_empty() {",
        "        return Ok(());",
        "    }",
        "    let pms = sym.detached_managers();",
        "    let plugins = &mut sym.config.plugins;",
        "    for name in approved {",
        "        if !plugins.is_auto_enabled(&pms, &CargoPm::id_for(name, None)) {",
        "            plugins.auto_enable.push(name.clone());",
        "        }",
        "    }",
        "    for name in declined {",
        "        if !plugins.is_disabled(&pms, &CargoPm::id_for(name, None)) {",
        "            plugins.disable.push(name.clone());",
        "        }",
        "    }",
        "    sym.save_config().context(\"failed to write user config\")?;",
        "",
        "    if !approved.is_empty() {",
        "        tracing::info!(",
        "            report = %ReportEvent::Info {",
        "                message: format!(\"enabled dependency plugins: {}\", approved.join(\", \")),",
        "            },",
        "        );",
        "    }",
        "    if !declined.is_empty() {",
        "        tracing::info!(",
        "            report = %ReportEvent::Info {",
        "                message: format!(",
        "                    \"declined dependency plugins (recorded in `[plugins] disable`): {}\",",
        "                    declined.join(\", \")",
        "                ),",
        "            },",
        "        );",
        "    }",
        "    Ok(())",
        "}"
      ]
    },
    {
      "rust_file": "src/discovery.rs",
      "rust_item": "fn[prompt_for_consent]",
      "text": [
        "/// Ask the user about each undecided offer, then record the answers.",
        "///",
        "/// **Never prompts unless `out` is interactive** ([`Output::is_interactive`]):",
        "/// hook dispatch and anything an agent triggers use a quiet or capturing",
        "/// output, so they return here immediately without touching stdin. In those",
        "/// contexts the candidates surface as a `SessionStart` hint instead (see",
        "/// [`pending_candidates`]).",
        "///",
        "/// Only explicit answers are recorded — the default (\"ask me later\") leaves",
        "/// the dependency undecided, so reflexively hitting Enter never permanently",
        "/// declines anything, and Escape leaves the remaining offers undecided too.",
        "// {impl}`design.requirements.consent.prompt_once_per_candidate`",
        "// {impl}`design.requirements.consent.prompt_describes_extensions`",
        "// {impl}`design.requirements.consent.approval_recorded`",
        "// {impl}`design.requirements.consent.decline_recorded`",
        "// {impl}`design.requirements.consent.deferral_records_nothing`",
        "pub async fn prompt_for_consent(",
        "    sym: &mut Symposium,",
        "    deps: &Arc<Workspace>,",
        "    out: &Output,",
        ") -> Result<()> {",
        "    // {impl}`design.requirements.hooks.no_prompt`",
        "    if !out.is_interactive() {",
        "        return Ok(());",
        "    }",
        "    let candidates = discover_for(sym, deps).await.candidates;",
        "    if candidates.is_empty() {",
        "        return Ok(());",
        "    }",
        "",
        "    let mut approved = Vec::new();",
        "    let mut declined = Vec::new();",
        "    let mut seen = std::collections::HashSet::new();",
        "    for candidate in candidates {",
        "        let name = candidate.id.name;",
        "        if !seen.insert(name.clone()) {",
        "            continue;",
        "        }",
        "        let what = candidate",
        "            .description",
        "            .as_deref()",
        "            .unwrap_or(\"agent extensions\");",
        "        let answer = dialoguer::Select::new()",
        "            .with_prompt(format!(\"Dependency `{name}` provides {what}. Enable it?\"))",
        "            .items([\"Ask me later\", \"Enable\", \"No — don't ask again\"])",
        "            .default(0)",
        "            .interact_opt()",
        "            .context(\"consent prompt failed\")?;",
        "        match answer {",
        "            Some(1) => approved.push(name),",
        "            Some(2) => declined.push(name),",
        "            Some(_) => {}  // ask me later — record nothing",
        "            None => break, // Esc — leave the rest undecided",
        "        }",
        "    }",
        "    apply_consent(sym, &approved, &declined)",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[apply_consent_records_both_answers]",
      "text": [
        "/// Recorded consent is durable in both directions: approval enables and the",
        "/// candidate stops being offered; a decline is remembered too.",
        "// {test}`design.requirements.consent.consented_active`",
        "// {test}`design.requirements.consent.approval_recorded`",
        "// {test}`design.requirements.consent.decline_recorded`",
        "#[tokio::test]",
        "async fn apply_consent_records_both_answers() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let workspace_root = ctx.workspace_root.clone().unwrap();",
        "",
        "            symposium::discovery::apply_consent(&mut ctx.sym, &[\"crate-a\".to_string()], &[])?;",
        "            assert!(read_config(&ctx).contains(\"auto-enable\"));",
        "",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            find_installed_skill(&workspace_root.join(\".claude/skills\"), \"a-guidance\");",
        "",
        "            let deps = ctx.sym.workspace(&workspace_root);",
        "            assert!(",
        "                symposium::discovery::pending_candidates(&ctx.sym, &deps)",
        "                    .await",
        "                    .is_empty(),",
        "                \"a decided dependency is not offered again\"",
        "            );",
        "",
        "            symposium::discovery::apply_consent(&mut ctx.sym, &[], &[\"other-dep\".to_string()])?;",
        "            assert!(read_config(&ctx).contains(\"disable\"));",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    }
  ],
  "rationale": "`prompt_for_consent` maps the \"Enable\" choice (`Some(1)`) to `approved` and passes it to `apply_consent`, which pushes each approved name onto `sym.config.plugins.auto_enable` (unless `is_auto_enabled` already covers it, e.g. via `\"*\"` or another spelling, so no duplicate) and then `save_config()`; a save failure is returned as an error.\n\nTest (passes): `tests/enablement.rs` `apply_consent_records_both_answers`: `apply_consent(&[\"crate-a\"], &[])` writes `auto-enable` to `config.toml`, the next `sync` installs the skill, and `pending_candidates` no longer offers it. The prompt-to-`approved` mapping itself needs a TTY and is judged from code.",
  "requirement": "Symposium MUST record a consent approval as a `[plugins] auto-enable` entry."
}
