      "rust_file": "src/hook.rs",
      "rust_item": "fn[run_auto_sync]",
      "text": [
        "/// Run sync if we're in a workspace and auto-sync is enabled. Non-fatal.",
        "///",
        "/// On most events this uses the state recorded at the last sync from this",
        "/// session's directory to skip sync when none of the files the package",
        "/// managers named as their inputs (a lockfile, say) has changed since. Deciding",
        "/// that reads only those files' modification times, and the workspace and",
        "/// dependencies recorded with them are reused, so no package manager is asked",
        "/// where the workspace is or what it depends on. If sync runs, `deps` gets populated, and later hook stages reuse",
        "/// the result.",
        "///",
        "/// A sync is recorded even when a package manager failed. Its cleanup was",
        "/// skipped, so nothing it installed was removed, and it is asked again at the",
        "/// next `SessionStart` or once another input changes, rather than on every",
        "/// event: a hung one would otherwise cost its timeout each time.",
        "///",
        "/// `SessionStart` runs once per session, so there we do the real work: refresh",
        "/// every source cache (`UpdateLevel::Check`) and sync unconditionally, ignoring",
        "/// the freshness gate, so upstream skill changes land even when the",
        "/// workspace's dependencies are unchanged.",
        "///",
        "/// Returns whether it re-synced mid-session because an input changed.",
        "// {impl}`design.requirements.hooks.auto_sync_session_start`",
        "// {impl}`design.requirements.hooks.auto_sync_gate`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.hooks.new_plugins_notice`",
        "async fn run_auto_sync(sym: &Symposium, deps: &Arc<Workspace>, session_start: bool) -> bool {",
        "    if !sym.config.auto_sync {",
        "        tracing::debug!(\"auto-sync disabled, skipping\");",
        "        return false;",
        "    }",
        "    let Some(start) = deps.start().map(Path::to_path_buf) else {",
        "        return false;",
        "    };",
        "",
        "    let mut state = crate::workspace_state::WorkspaceState::load(sym, &start);",
        "    if !session_start && let Some((workspace, dep_ids)) = state.fresh() {",
        "        tracing::debug!(\"auto-sync skipped: no package manager input changed since last sync\");",
        "        deps.reuse(workspace, dep_ids);",
        "        return false;",
        "    }",
        "    if deps.info().await.is_none() {",
        "        tracing::debug!(\"auto-sync skipped: not in a workspace\");",
        "        return false;",
        "    }",
        "",
        "    let update = if session_start {",
        "        symposium_install::UpdateLevel::Check",
        "    } else {",
        "        symposium_install::UpdateLevel::None",
        "    };",
        "",
        "    tracing::debug!(\"auto-sync running\");",
        "    if let Err(e) = crate::sync::sync(sym, deps, update).await {",
        "        tracing::warn!(error = %e, \"auto-sync during hook failed (continuing)\");",
        "        return false;",
        "    }",
        "",
        "    if let Some(workspace) = deps.info().await {",
        "        state.record_sync(workspace, deps.dep_ids().await);",
        "        state.save(sym, &start);",
        "    }",
        "    !session_start",
        "}"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[prewarm_hook_sources]",
      "text": [
        "/// Refresh the source cache for every hook the workspace could fire this",
        "/// session. Run once on `SessionStart` (where the per-session cost is",
        "/// acceptable) so later events dispatch fresh binaries from cache — dispatch",
        "/// itself acquires with `UpdateLevel::None`. This is also the only path that",
        "/// re-pulls a `cargo + git` hook binary whose branch moved, since its",
        "/// version-keyed cache never invalidates on its own.",
        "///",
        "/// Refresh-only: a source that was never acquired is left alone (it installs",
        "/// lazily when the hook first fires) — `SessionStart` updates installed tools",
        "/// but never installs eagerly. Best-effort: failures are logged and skipped.",
        "// {impl}`design.requirements.hooks.source_refresh_session_start`",
        "// {impl}`design.requirements.hooks.source_refresh_installed_only`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.hooks.hook_gating`",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.dormant_inactive`",
        "// {impl}`design.requirements.consent.use_wakes_dormant`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "async fn prewarm_hook_sources(sym: &Symposium, deps: &Arc<Workspace>) {",
        "    let workspace = deps.info().await.cloned();",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, workspace.as_ref()).await;",
        "",
        "    // Resolving the workspace runs cargo, so only do it when some hook's",
        "    // gating references a concrete crate, or there is crate-plugin expansion to",
        "    // perform (mirrors dispatch).",
        "    let dep_ids = if hook_dispatch_needs_deps(sym, &registry.plugins) {",
        "        deps.dep_ids().await.to_vec()",
        "    } else {",
        "        Vec::new()",
        "    };",
        "    let pms = deps.pms();",
        "    let used = workspace",
        "        .as_ref()",
        "        .map(|ws| crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root))",
        "        .unwrap_or_default();",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    let plugins = crate::plugins::active_plugins(",
        "        sym,",
        "        &registry,",
        "        pms,",
        "        workspace.as_ref().map(|ws| ws.root.as_path()),",
        "        &mut ctx,",
        "        symposium_install::UpdateLevel::None,",
        "    )",
        "    .await;",
        "",
        "    for parsed in &plugins {",
        "        if !parsed.applies(&mut ctx) {",
        "            continue;",
        "        }",
        "        for hook in &parsed.manifest.hooks {",
        "            if !hook.predicates.evaluate(&mut ctx) {",
        "                continue;",
        "            }",
        "            let resolved = match ResolvedHook::build(parsed, hook) {",
        "                Ok(r) => r,",
        "                Err(e) => {",
        "                    tracing::debug!(plugin = %parsed.manifest.name, hook = %hook.name, error = %e, \"prewarm: skipping unbuildable hook\");",
        "                    continue;",
        "                }",
        "            };",
        "            for req in &resolved.requirements {",
        "                if let Err(e) = refresh_installation_if_present(sym, req, None).await {",
        "                    tracing::debug!(name = %req.name, error = %e, \"prewarm: requirement refresh failed\");",
        "                }",
        "            }",
        "            if let Err(e) = refresh_installation_if_present(",
        "                sym,",
        "                &resolved.command,",
        "                resolved.hook_executable.as_deref(),",
        "            )",
        "            .await",
        "            {",
        "                tracing::debug!(plugin = %resolved.plugin_name, hook = %resolved.hook_name, error = %e, \"prewarm: command refresh failed\");",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[dispatch_plugin_hooks]",
      "text": [
        "/// Dispatch plugin hooks with format routing.",
        "///",
        "/// Accumulates output as `serde_json::Value` in the host agent's wire format.",
        "/// When a plugin's format matches the host agent, input/output pass through directly.",
        "/// When formats differ, conversion goes through symposium canonical types.",
        "/// `prior_context` is the context already in `prior_output`; every hook's",
        "/// context is added to it (see [`JoinedContext`]).",
        "///",
        "/// Returns `Ok(json)` on success, `Err(stderr)` on exit code 2.",
        "#[allow(clippy::too_many_arguments)]",
        "// {impl}`design.requirements.hooks.hook_gating`",
        "// {impl}`design.requirements.hooks.native_input`",
        "// {impl}`design.requirements.hooks.native_output`",
        "// {impl}`design.requirements.hooks.canonical_input`",
        "// {impl}`design.requirements.hooks.canonical_output`",
        "// {impl}`design.requirements.hooks.raw_json_fallback`",
        "// {impl}`design.requirements.hooks.hook_stdin_payload`",
        "// {impl}`design.requirements.hooks.merge_later_wins`",
        "// {impl}`design.requirements.hooks.joined_context`",
        "// {impl}`design.requirements.hooks.deny_final`",
        "// {impl}`design.requirements.hooks.exit_2_stops`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.dormant_inactive`",
        "// {impl}`design.requirements.consent.use_wakes_dormant`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "pub async fn dispatch_plugin_hooks(",
        "    sym: &Symposium,",
        "    host_agent: HookAgent,",
        "    event: HookEvent,",
        "    sym_input: &symposium::InputEvent,",
        "    original_input: &str,",
        "    prior_output: serde_json::Value,",
        "    prior_context: Option<String>,",
        "    deps: &Arc<Workspace>,",
        ") -> Result<serde_json::Value, Vec<u8>> {",
        "    let workspace = deps.info().await.cloned();",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, workspace.as_ref()).await;",
        "",
        "    // Resolving the workspace means running cargo, so only do it when some",
        "    // plugin's hook gating references a concrete crate (a `depends-on(*)`",
        "    // wildcard or env/shell/path predicate never needs the crate graph), or",
        "    // when there is crate-plugin expansion to perform — that too evaluates",
        "    // predicates against the crate graph.",
        "    let dep_ids = if hook_dispatch_needs_deps(sym, &registry.plugins) {",
        "        deps.dep_ids().await.to_vec()",
        "    } else {",
        "        Vec::new()",
        "    };",
        "    let pms = deps.pms();",
        "    let used = workspace",
        "        .as_ref()",
        "        .map(|ws| crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root))",
        "        .unwrap_or_default();",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    // Dispatch over the active set — registry plugins plus crate-sourced ones —",
        "    // so a crate plugin's hooks fire exactly like a registry plugin's.",
        "    let plugins = crate::plugins::active_plugins(",
        "        sym,",
        "        &registry,",
        "        pms,",
        "        workspace.as_ref().map(|ws| ws.root.as_path()),",
        "        &mut ctx,",
        "        symposium_install::UpdateLevel::None,",
        "    )",
        "    .await;",
        "    let hooks = dispatched_hooks_for_payload(&plugins, sym_input, host_agent, &mut ctx);",
        "",
        "    let mut output = prior_output;",
        "    let mut context = JoinedContext::new(event, prior_context);",
        "",
        "    for hook in hooks {",
        "        tracing::info!(",
        "            plugin = %hook.plugin_name,",
        "            hook = %hook.hook_name,",
        "            format = ?hook.format,",
        "            \"running plugin hook\"",
        "        );",
        "",
        "        // Determine stdin for the plugin based on its declared format.",
        "        // After format selection, the only two cases are:",
        "        // - native (matches host agent) → the agent's own payload, byte for byte",
        "        // - symposium → deliver canonical format",
        "        let hook_agent = hook.format.as_agent();",
        "        let stdin_str = if hook_agent == Some(host_agent) {",
        "            original_input.to_string()",
        "        } else {",
        "            match AgentHookInput::to_string(sym_input) {",
        "                Ok(s) => s,",
        "                Err(e) => {",
        "                    tracing::error!(plugin = %hook.plugin_name, hook = %hook.hook_name, error = %e, \"failed to serialize hook input\");",
        "                    continue;",
        "                }",
        "            }",
        "        };",
        "",
        "        let spawn_res = match build_spawn_spec(sym, &hook).await {",
        "            Ok(spec) => spawn_from_spec(spec),",
        "            Err(e) => {",
        "                tracing::warn!(error = %e, \"failed to prepare hook command\");",
        "                continue;",
        "            }",
        "        };",
        "",
        "        match spawn_res {",
        "            Ok(mut child) => {",
        "                if let Some(mut stdin) = child.stdin.take() {",
        "                    let _ = stdin.write_all(stdin_str.as_bytes());",
        "                }",
        "",
        "                let child_out = match child.wait_with_output() {",
        "                    Ok(o) => o,",
        "                    Err(e) => {",
