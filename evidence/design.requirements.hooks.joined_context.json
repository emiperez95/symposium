        "            json!({",
        "                \"hookSpecificOutput\": {",
        "                    \"hookEventName\": \"SessionStart\",",
        "                    \"additionalContext\": \"noisy plugin context\",",
        "                    \"reloadSkills\": true,",
        "                }",
        "            })",
        "        );",
        "        assert!(String::from_utf8_lossy(&output.stderr).contains(\"installing noisy tool\"));",
        "        Ok(())",
        "    })",
        "    .await",
        "    .unwrap();",
        "}"
      ]
