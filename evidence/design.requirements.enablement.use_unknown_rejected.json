      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[use_unknown_name_errors]",
      "text": [
        "/// A name that is neither a workspace dependency nor a registry hit is",
        "/// rejected instead of recorded.",
        "// {test}`design.requirements.enablement.use_unknown_rejected`",
        "#[tokio::test]",
        "async fn use_unknown_name_errors() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"no-such-plugin\"])",
        "                .await",
        "                .expect_err(\"unknown name should be rejected\");",
        "            assert!(",
        "                err.to_string()",
        "                    .contains(\"no package named `no-such-plugin`\"),",
        "                \"{err}\"",
        "            );",
        "            assert!(",
        "                !read_config(&ctx).contains(\"no-such-plugin\"),",
        "                \"nothing recorded\"",
        "            );",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[use_matches_registry_plugin_names_exactly]",
      "text": [
        "// {test}`design.requirements.consent.registry_name_exact`",
        "// {test}`design.requirements.enablement.use_unknown_rejected`",
        "#[tokio::test]",
        "async fn use_matches_registry_plugin_names_exactly() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"dormant-plugin0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"gateless_plugin\"])",
        "                .await",
        "                .expect_err(\"a registry plugin name is not a crate name\");",
        "            assert!(",
        "                err.to_string()",
        "                    .contains(\"no package named `gateless_plugin`\"),",
        "                \"{err}\"",
        "            );",
        "            assert!(!read_config(&ctx).contains(\"gateless_plugin\"));",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "src/use_command.rs",
      "rust_item": "fn[use_plugin]",
      "text": [
        "/// Record an enablement for `name` and sync so its skills install now.",
        "pub async fn use_plugin(",
        "    sym: &mut Symposium,",
        "    cwd: &Path,",
        "    name: &str,",
        "    global: bool,",
        "    update: UpdateLevel,",
        ") -> Result<()> {",
        "    let deps = sym.workspace(cwd);",
        "    let pms = deps.pms();",
        "    let registry = crate::plugins::load_registry(sym).await;",
        "    let id = match pms",
        "        .identify(&registry.plugins, name, UpdateLevel::Check)",
        "        .await",
        "    {",
        "        Ok(id) => id,",
        "        Err(e) => bail!(\"{e} (try `cargo agents search {name}`)\"),",
        "    };",
        "",
        "    // `disable` outranks every way of enabling a plugin, `use` included, so",
        "    // recording an entry here would report success and then install nothing.",
        "    // Re-enabling is dropping the `disable` entry, which is a deliberate edit",
        "    // rather than something `use` undoes on the user's behalf.",
        "    if sym",
        "        .config",
        "        .plugins",
        "        .is_disabled(pms, &PackageId::any_version(&id.pm, name))",
        "    {",
        "        bail!(\"`{name}` is disabled in `[plugins] disable`; remove that entry to enable it again\");",
        "    }",
        "",
        "    // A configured registry is a trust root: what it offers is already",
        "    // enabled by configuration, so there is nothing to record. The exception",
        "    // is a dormant plugin, for which `use` is exactly the wake-up call.",
        "    let registry_plugin = registry",
        "        .plugins",
        "        .iter()",
        "        .find(|p| pms.identity(&p.canonical) == id);",
        "    let dormant = registry_plugin.is_some_and(|p| p.manifest.requires_use);",
        "    let already_trusted = registry_plugin.is_some() && !dormant;",
        "    if already_trusted {",
        "        tracing::info!(",
        "            report = %ReportEvent::Info {",
        "                message: format!(",
        "                    \"`{name}` is already available from a configured registry; nothing to enable\"",
        "                ),",
        "            },",
        "        );",
        "        return Ok(());",
        "    }",
        "",
        "    let workspace_root = deps.root().await.map(Path::to_path_buf);",
        "    if !global && let Err(e) = deps.require_info().await {",
        "        bail!(\"{e}; pass --global to enable `{name}` everywhere\");",
        "    }",
        "",
        "    let entry = match &workspace_root {",
        "        _ if global => UseEntry::Global(name.to_string()),",
        "        Some(root) => UseEntry::Workspace {",
        "            name: name.to_string(),",
        "            workspace: root.clone(),",
        "        },",
        "        None => unreachable!(\"checked above\"),",
        "    };",
        "",
        "    let mut already_enabled = false;",
        "    for e in &sym.config.plugins.used {",
        "        if in_scope(e, global, workspace_root.as_deref())",
        "            && names(pms, &registry.plugins, e.name(), name, Some(&id)).await",
        "        {",
        "            already_enabled = true;",
        "            break;",
        "        }",
        "    }",
        "    if already_enabled {",
        "        tracing::info!(",
        "            report = %ReportEvent::Info {",
        "                message: format!(\"`{name}` is already enabled; nothing changed\"),",
        "            },",
        "        );",
        "    } else {",
        "        sym.config.plugins.used.push(entry);",
        "        sym.save_config().context(\"failed to write user config\")?;",
        "        tracing::info!(",
        "            report = %ReportEvent::PluginEnabled {",
        "                name: name.to_string(),",
        "                global,",
        "            },",
        "        );",
        "    }",
        "",
        "    // Install now rather than waiting for the next sync.",
        "    if workspace_root.is_some() {",
        "        crate::sync::sync(sym, &deps, update).await?;",
        "    }",
        "    Ok(())",
        "}"
      ]
    }
  ],
  "rationale": "`use_plugin` first calls `pms.identify(&registry.plugins, name, UpdateLevel::Check)`; on `Err` it bails with `{e} (try `cargo agents search {name}`)` (the error text is `no package named ...`). This happens before any mutation of `sym.config` and before `save_config`, so nothing is written.\n\nTests (pass): `use_unknown_name_errors` asserts `use no-such-plugin` errors with `no package named `no-such-plugin`` and the config does not contain the name; `use_matches_registry_plugin_names_exactly` asserts `use gateless_plugin` (a folded spelling of a registry plugin, which registries compare exactly) errors the same way and records nothing.",
  "requirement": "`cargo agents use <name>` MUST fail without changing the config when `<name>` resolves to no package."
}
