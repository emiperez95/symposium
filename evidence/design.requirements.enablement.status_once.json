{
  "determination": false,
  "inputs": [
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[status_lists_each_declined_name_once]",
      "text": [
        "// {test}`design.requirements.consent.crate_name_matching`",
        "// {test}`design.requirements.enablement.status_once`",
        "// {test}`design.requirements.enablement.status_state`",
        "#[tokio::test]",
        "async fn status_lists_each_declined_name_once() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let workspace_root = ctx.workspace_root.clone().unwrap();",
        "            ctx.sym.config.plugins.disable = [\"crate_a\", \"*\", \"never-seen\", \"never_seen\"]",
        "                .map(String::from)",
        "                .to_vec();",
        "",
        "            let deps = ctx.sym.workspace(&workspace_root);",
        "            let entries = symposium::status_command::workspace_status(&ctx.sym, &deps).await?;",
        "            let named = |name: &str| {",
        "                entries",
        "                    .iter()",
        "                    .filter(|e| e.name.replace('_', \"-\") == name)",
        "                    .collect::<Vec<_>>()",
        "            };",
        "",
        "            let crate_a = named(\"crate-a\");",
        "            assert_eq!(crate_a.len(), 1, \"{entries:?}\");",
        "            assert_eq!(crate_a[0].state, StatusState::Declined);",
        "            assert_eq!(crate_a[0].version.as_deref(), Some(\"0.1.0\"));",
        "            assert!(named(\"*\").is_empty(), \"{entries:?}\");",
        "            // No package manager has `never-seen`, so nothing says the two",
        "            // spellings are one package.",
        "            let never_seen = named(\"never-seen\");",
        "            assert_eq!(never_seen.len(), 2, \"{entries:?}\");",
        "            assert!(never_seen.iter().all(|e| e.state == StatusState::Declined));",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "src/status_command.rs",
      "rust_item": "fn[workspace_status]",
      "text": [
        "/// Compute the enablement report for the workspace `deps` points at.",
        "pub async fn workspace_status(",
        "    sym: &Symposium,",
        "    workspace: &Arc<Workspace>,",
        ") -> Result<Vec<StatusEntry>> {",
        "    let ws = workspace.require_info().await?.clone();",
        "",
        "    let mut entries = Vec::new();",
        "",
        "    // Manifest plugins: workspace members and registry offerings. Both are",
        "    // trust roots, so the only questions are the `use` gate for dormant",
        "    // plugins and whether the predicates hold.",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, Some(&ws)).await;",
        "    let dep_ids = workspace.dep_ids().await.to_vec();",
        "    let pms = workspace.pms();",
        "    let used = crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root);",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    for parsed in &registry.plugins {",
        "        let root = if parsed.workspace_member {",
        "            \"workspace member\".to_string()",
        "        } else if parsed.manifest.requires_use && ctx.is_used(&parsed.canonical) {",
        "            \"`[plugins] use`\".to_string()",
        "        } else {",
        "            format!(\"registry `{}`\", parsed.canonical.pm)",
        "        };",
        "        let active = parsed.applies(&mut ctx);",
        "        entries.push(StatusEntry {",
        "            name: parsed.manifest.name.clone(),",
        "            version: None,",
        "            root: if active || !parsed.manifest.requires_use {",
        "                root",
        "            } else {",
        "                format!(\"{root} (dormant: awaiting `cargo agents use`)\")",
        "            },",
        "            state: if active {",
        "                StatusState::Active",
        "            } else {",
        "                StatusState::Dormant",
        "            },",
        "        });",
        "    }",
        "",
        "    // Dependency-embedded plugins, with the decision the config made about",
        "    // each. This is the same view the consent prompt works from.",
        "    let discovery = crate::discovery::discover(sym, workspace, &registry.plugins).await;",
        "    for found in discovery",
        "        .active",
        "        .iter()",
        "        .chain(&discovery.auto_enabled)",
        "        .chain(&discovery.candidates)",
        "        .chain(&discovery.declined)",
        "    {",
        "        entries.push(entry_for(found));",
        "    }",
        "",
        "    // Crates enabled by `use` that are *not* dependency-embedded offers — e.g.",
        "    // `cargo agents use <crate>` for a crate the workspace doesn't depend on.",
        "    // Discovery only sees dependencies, so these are invisible above; surface",
        "    // them from the config the same way sync loads them",
        "    // ([`enabled_dependencies`](crate::discovery::enabled_dependencies)).",
        "    let shown: std::collections::HashSet<crate::pm::PackageId> = registry",
        "        .plugins",
        "        .iter()",
        "        .map(|p| pms.identity(&p.canonical))",
        "        .chain(",
        "            discovery",
        "                .active",
        "                .iter()",
        "                .chain(&discovery.auto_enabled)",
        "                .chain(&discovery.candidates)",
        "                .chain(&discovery.declined)",
        "                .map(|d| pms.identity(&d.id)),",
        "        )",
        "        .collect();",
        "    let enabled = crate::discovery::enabled_dependencies(",
        "        sym,",
        "        pms,",
        "        &registry.plugins,",
        "        &dep_ids,",
        "        &ws.root,",
        "        UpdateLevel::None,",
        "    )",
        "    .await;",
        "    let used =",
        "        crate::discovery::resolve_used(sym, pms, &registry.plugins, &ws.root, UpdateLevel::None)",
        "            .await;",
        "    for id in enabled {",
        "        if shown.contains(&pms.identity(&id)) {",
        "            continue;",
        "        }",
        "        let dependency = dep_ids",
        "            .iter()",
        "            .any(|dep| pms.identity(dep) == pms.identity(&id));",
        "        let named = used.iter().any(|(_, used)| *used == pms.identity(&id));",
        "        if dependency && !named {",
        "            continue;",
        "        }",
        "        entries.push(StatusEntry {",
        "            name: id.name,",
        "            version: None,",
        "            root: if dependency {",
        "                \"`[plugins] use` (offers no plugin)\"",
        "            } else {",
        "                \"`[plugins] use` (not a dependency)\"",
        "            }",
        "            .to_string(),",
        "            state: if dependency {",
        "                StatusState::Dormant",
        "            } else {",
        "                StatusState::Active",
        "            },",
        "        });",
        "    }",
        "    let mut missing = std::collections::HashSet::new();",
        "    for name in sym.config.plugins.used_names_in(&ws.root) {",
        "        if !missing.insert(name)",
        "            || pms",
        "                .identify(&registry.plugins, name, UpdateLevel::None)",
        "                .await",
        "                .is_ok()",
        "        {",
        "            continue;",
        "        }",
        "        entries.push(StatusEntry {",
        "            name: name.to_string(),",
        "            version: None,",
        "            root: \"`[plugins] use` (not a registry plugin, a dependency or a cached crate)\"",
        "                .to_string(),",
        "            state: StatusState::Dormant,",
        "        });",
        "    }",
        "",
        "    // Names declined without ever being discovered (a `disable` entry for a",
        "    // dependency whose source isn't on disk, or one added by hand). A name no",
        "    // package manager has can only be compared as written.",
        "    let mut declined: std::collections::HashSet<crate::pm::PackageId> = discovery",
        "        .declined",
        "        .iter()",
        "        .map(|d| pms.identity(&d.id))",
        "        .collect();",
        "    // `disable` does not reach registry or workspace plugins (they are trust",
        "    // roots), and those are already listed above with the state they have.",
        "    let trusted: std::collections::HashSet<crate::pm::PackageId> = registry",
        "        .plugins",
        "        .iter()",
        "        .map(|p| pms.identity(&p.canonical))",
        "        .collect();",
        "    let mut unknown = std::collections::HashSet::new();",
        "    for name in &sym.config.plugins.disable {",
        "        if name == \"*\" {",
        "            continue;",
        "        }",
        "        let first = match pms",
        "            .identify(&registry.plugins, name, UpdateLevel::None)",
        "            .await",
        "        {",
        "            Ok(id) if trusted.contains(&id) => continue,",
        "            Ok(id) => declined.insert(id),",
        "            Err(_) => unknown.insert(name.as_str()),",
        "        };",
        "        if !first {",
        "            continue;",
        "        }",
        "        entries.push(StatusEntry {",
        "            name: name.clone(),",
        "            version: None,",
        "            root: \"declined (`[plugins] disable`)\".to_string(),",
        "            state: StatusState::Declined,",
        "        });",
        "    }",
        "",
        "    Ok(entries)",
        "}"
      ]
    },
    {
      "rust_file": "src/status_command.rs",
      "rust_item": "fn[status]",
      "text": [
        "/// The `cargo agents status` entry point.",
        "pub async fn status(sym: &Symposium, cwd: &Path) -> Result<()> {",
        "    let deps = sym.workspace(cwd);",
        "    let entries = workspace_status(sym, &deps).await?;",
        "    if entries.is_empty() {",
        "        tracing::info!(",
        "            report = %ReportEvent::Info {",
        "                message: \"no plugins enabled for this workspace\".to_string(),",
        "            },",
        "        );",
        "        return Ok(());",
        "    }",
        "    for entry in entries {",
        "        tracing::info!(",
        "            report = %ReportEvent::PluginStatus {",
        "                name: entry.name,",
        "                version: entry.version,",
        "                root: entry.root,",
        "                state: entry.state.as_str().to_string(),",
        "            },",
        "        );",
        "    }",
        "    Ok(())",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[status_lists_a_disabled_registry_plugin_once]",
      "text": [
        "/// `disable` does not reach a registry plugin, so status lists it once, in the",
        "/// state activation gives it, not also as declined.",
        "// {test}`design.requirements.enablement.status_once`",
        "// {test}`design.requirements.enablement.status_state`",
        "#[tokio::test]",
        "async fn status_lists_a_disabled_registry_plugin_once() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"dormant-plugin0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let workspace_root = ctx.workspace_root.clone().unwrap();",
        "            ctx.sym",
        "                .config",
        "                .plugins",
        "                .disable",
        "                .push(\"gateless-plugin\".to_string());",
        "",
        "            let deps = ctx.sym.workspace(&workspace_root);",
        "            let entries = symposium::status_command::workspace_status(&ctx.sym, &deps).await?;",
        "            let listed: Vec<_> = entries",
        "                .iter()",
        "                .filter(|e| e.name == \"gateless-plugin\")",
        "                .collect();",
        "            assert_eq!(listed.len(), 1, \"{entries:#?}\");",
        "            assert_eq!(listed[0].state, StatusState::Dormant);",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    }
  ],
  "rationale": "**Does not hold: a name in both `[plugins] use` and `[plugins] disable` that no package manager resolves offline is listed twice, under the same spelling, with two different states.**\n\n`status` (`src/status_command.rs`) emits one `PluginStatus` report line per `StatusEntry` that `workspace_status` returns, so the requirement reduces to `workspace_status` never returning two entries for one plugin. It builds the list in five passes:\n\n1. one entry per registry/workspace plugin (`registry.plugins`);\n2. one entry per dependency-embedded offer in the `discover` buckets. `decide` puts each offer in exactly one bucket (`disable` checked first), and the cargo transport's `active_plugins` walks `dep_ids`, which `pm/cargo/workspace.rs` dedups by crate name;\n3. `use`-enabled crates from `enabled_dependencies`, skipped when their identity is already in `shown` (passes 1 and 2). `enabled_dependencies` dedups by identity (`known`) and prunes disabled names;\n4. `use` names that `identify` cannot resolve at `UpdateLevel::None`, deduplicated only by raw spelling (`missing`);\n5. `disable` names. `\"*\"` is skipped, and so are names that resolve to a trusted plugin (already shown in pass 1). Names that resolve to an id are deduplicated against the declined offers from pass 2 (`declined`), and unresolvable names by raw spelling (`unknown`).\n\nPasses 1-3 and 5 agree on identities, so a resolvable plugin is listed once. Passes 4 and 5 do not check each other. `used_names_in` does not filter out disabled names, so an unresolvable name in both lists gets a Dormant line from pass 4 and a Declined line from pass 5. I reproduced this with the current `target/debug/cargo-agents` (built after the latest `src/status_command.rs` change), an empty cargo project and `use = [\"ghost-xyz-nope\"]`, `disable = [\"ghost-xyz-nope\"]`:\n\n```\n💤 ghost-xyz-nope — `[plugins] use` (not a registry plugin, a dependency or a cached crate)\n➖ ghost-xyz-nope — declined (`[plugins] disable`)\n```\n\nThis can happen in practice, not only with a hand-edited config. `use` resolves through crates.io search, but status resolves cache-only, so a crate that was `use`d and then disabled (sync never fetches a disabled crate) shows up this way. The chapter note's by-design exception covers two *different* spellings (`never-seen` / `never_seen`), not one name listed twice. Pass 4 likewise lists two `use` spellings of one unresolvable name twice. That fits the spirit of the note, but the note names only `disable`.\n\nTests (both pass, `cargo test -q --test enablement status_lists`):\n- `status_lists_each_declined_name_once`: a declined dependency (`crate_a`) appears once as Declined with its version, `\"*\"` is not listed, and the two unknown `disable` spellings appear twice.\n- `status_lists_a_disabled_registry_plugin_once`: a disabled registry plugin appears once, as Dormant, not also as Declined.\n\nNo test covers a name that is both `use`d and disabled.",
  "requirement": "`cargo agents status` MUST list each plugin it reports on one line."
}
