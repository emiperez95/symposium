        "            .iter()",
        "            .map(|name| lookup(name))",
        "            .collect::<anyhow::Result<Vec<_>>>()?;",
        "",
        "        Ok(Self {",
        "            plugin_name: parsed_plugin.manifest.name.clone(),",
        "            hook_name: hook.name.clone(),",
        "            format: hook.format.clone(),",
        "            requirements,",
