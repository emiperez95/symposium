    {
      "rust_file": "src/discovery.rs",
      "rust_item": "fn[discover]",
      "text": [
        "/// Discover the plugins offered for this workspace's dependencies.",
        "///",
        "/// `workspace_root` scopes the `use` entries that count (an entry can be",
        "/// recorded for one workspace only). `active_plugins` fetches each dependency",
        "/// cache-only — for a workspace dependency, into the source `cargo metadata`",
        "/// already extracted (no probe, no network) — so every dependency-embedded",
        "/// plugin is discoverable, registry crates included.",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "// {impl}`design.requirements.enablement.status_state`",
        "// {impl}`design.requirements.hooks.consent_hint_names`",
        "pub async fn discover(sym: &Symposium, ws: &Arc<Workspace>, registry: &[Plugin]) -> Discovery {",
        "    let Some(workspace_root) = ws.root().await.map(Path::to_path_buf) else {",
        "        return Discovery::default();",
        "    };",
        "    let pms = ws.pms();",
        "    let dep_ids = ws.dep_ids().await;",
        "    let used: HashSet<PackageId> =",
        "        resolve_used(sym, pms, registry, &workspace_root, UpdateLevel::None)",
        "            .await",
        "            .into_iter()",
        "            .map(|(_, id)| id)",
        "            .collect();",
        "",
        "    let mut discovery = Discovery::default();",
        "    // Untrusted instances = the cargo transport: its `active_plugins` are the",
        "    // plugins embedded in dependencies, which run only with consent. Classify",
        "    // each against the `[plugins]` config.",
        "    for inst in pms.instances().filter(|i| !i.trusted) {",
        "        for plugin in inst.active_plugins(dep_ids).await {",
        "            let name = plugin.canonical.name.clone();",
        "            let description = Some(describe_plugin(&plugin.manifest));",
        "            let enablement = decide(sym, pms, &used, &plugin.canonical);",
        "            let discovered = DiscoveredPlugin {",
        "                registry: inst.name.clone(),",
        "                id: plugin.canonical,",
        "                recommends: name,",
        "                description,",
        "                enablement,",
        "            };",
        "            match enablement {",
        "                Enablement::Used => discovery.active.push(discovered),",
        "                Enablement::AutoEnabled => discovery.auto_enabled.push(discovered),",
        "                Enablement::Declined => discovery.declined.push(discovered),",
        "                Enablement::Candidate => discovery.candidates.push(discovered),",
        "            }",
        "        }",
        "    }",
        "    discovery",
        "}"
      ]
    },
    {
      "rust_file": "src/discovery.rs",
      "rust_item": "fn[resolve_used]",
      "text": [
        "// {impl}`design.requirements.consent.scoped_use`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "// {impl}`design.requirements.consent.unresolved_use_skipped`",
        "// {impl}`design.requirements.consent.use_resolves_registry_first`",
        "pub(crate) async fn resolve_used<'a>(",
        "    sym: &'a Symposium,",
        "    pms: &PmRegistry,",
        "    registry: &[Plugin],",
        "    workspace_root: &Path,",
        "    update: UpdateLevel,",
        ") -> Vec<(&'a str, PackageId)> {",
        "    let mut used = Vec::new();",
        "    for name in sym.config.plugins.used_names_in(workspace_root) {",
        "        match pms.identify(registry, name, update).await {",
        "            Ok(id) => used.push((name, id)),",
        "            Err(e) => tracing::warn!(error = %e, \"skipping `[plugins] use` entry\"),",
        "        }",
        "    }",
        "    used",
        "}"
      ]
    },
    {
      "rust_file": "src/discovery.rs",
      "rust_item": "mod[tests]/fn[resolving_use_entries_without_update_stays_offline]",
      "text": [
        "    /// Hook dispatch, `--help` and subcommand dispatch build the active set at",
        "    /// `UpdateLevel::None`, so a `use` entry for a crate that is neither a",
        "    /// dependency nor cached is skipped without a crates.io search or a cargo",
        "    /// process; `sync` resolves it at `Check`.",
        "    // {test}`design.requirements.consent.offline_resolution`",
        "    // {test}`design.requirements.consent.unresolved_use_skipped`",
        "    #[tokio::test]",
        "    async fn resolving_use_entries_without_update_stays_offline() {",
        "        let tmp = tempfile::tempdir().unwrap();",
        "        let sym = sym_with(",
        "            tmp.path(),",
        "            indoc! {r#\"",
        "                [plugins]",
        "                use = [\"published-crate\"]",
        "            \"#},",
        "        );",
        "        let registry = crate::plugins::load_registry(&sym).await;",
        "        let (cargo, network) = crate::test_utils::FakeCargo::instance(&[], &[\"published-crate\"]);",
        "        let pms = PmRegistry::new(vec![cargo]);",
        "        let active_at = async |update| {",
        "            let mut ctx = crate::predicate::PredicateContext::new(&[]);",
        "            crate::plugins::active_plugins(",
        "                &sym,",
        "                &registry,",
        "                &pms,",
        "                Some(tmp.path()),",
        "                &mut ctx,",
        "                update,",
        "            )",
        "            .await",
        "        };",
        "",
        "        active_at(UpdateLevel::None).await;",
        "        assert_eq!(network.load(std::sync::atomic::Ordering::SeqCst), 0);",
        "",
        "        active_at(UpdateLevel::Check).await;",
        "        assert_eq!(network.load(std::sync::atomic::Ordering::SeqCst), 2);",
        "    }"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[prewarm_hook_sources]",
      "text": [
        "/// Refresh the source cache for every hook the workspace could fire this",
        "/// session. Run once on `SessionStart` (where the per-session cost is",
        "/// acceptable) so later events dispatch fresh binaries from cache — dispatch",
        "/// itself acquires with `UpdateLevel::None`. This is also the only path that",
        "/// re-pulls a `cargo + git` hook binary whose branch moved, since its",
        "/// version-keyed cache never invalidates on its own.",
        "///",
        "/// Refresh-only: a source that was never acquired is left alone (it installs",
        "/// lazily when the hook first fires) — `SessionStart` updates installed tools",
        "/// but never installs eagerly. Best-effort: failures are logged and skipped.",
        "// {impl}`design.requirements.hooks.source_refresh_session_start`",
        "// {impl}`design.requirements.hooks.source_refresh_installed_only`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.hooks.hook_gating`",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.dormant_inactive`",
        "// {impl}`design.requirements.consent.use_wakes_dormant`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "async fn prewarm_hook_sources(sym: &Symposium, deps: &Arc<Workspace>) {",
        "    let workspace = deps.info().await.cloned();",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, workspace.as_ref()).await;",
        "",
        "    // Resolving the workspace runs cargo, so only do it when some hook's",
        "    // gating references a concrete crate, or there is crate-plugin expansion to",
        "    // perform (mirrors dispatch).",
        "    let dep_ids = if hook_dispatch_needs_deps(sym, &registry.plugins) {",
        "        deps.dep_ids().await.to_vec()",
        "    } else {",
        "        Vec::new()",
        "    };",
        "    let pms = deps.pms();",
        "    let used = workspace",
        "        .as_ref()",
        "        .map(|ws| crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root))",
        "        .unwrap_or_default();",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    let plugins = crate::plugins::active_plugins(",
        "        sym,",
        "        &registry,",
        "        pms,",
        "        workspace.as_ref().map(|ws| ws.root.as_path()),",
        "        &mut ctx,",
        "        symposium_install::UpdateLevel::None,",
        "    )",
        "    .await;",
        "",
        "    for parsed in &plugins {",
        "        if !parsed.applies(&mut ctx) {",
        "            continue;",
        "        }",
        "        for hook in &parsed.manifest.hooks {",
        "            if !hook.predicates.evaluate(&mut ctx) {",
        "                continue;",
        "            }",
        "            let resolved = match ResolvedHook::build(parsed, hook) {",
        "                Ok(r) => r,",
        "                Err(e) => {",
        "                    tracing::debug!(plugin = %parsed.manifest.name, hook = %hook.name, error = %e, \"prewarm: skipping unbuildable hook\");",
        "                    continue;",
        "                }",
        "            };",
        "            for req in &resolved.requirements {",
        "                if let Err(e) = refresh_installation_if_present(sym, req, None).await {",
        "                    tracing::debug!(name = %req.name, error = %e, \"prewarm: requirement refresh failed\");",
        "                }",
        "            }",
        "            if let Err(e) = refresh_installation_if_present(",
        "                sym,",
        "                &resolved.command,",
        "                resolved.hook_executable.as_deref(),",
        "            )",
        "            .await",
        "            {",
        "                tracing::debug!(plugin = %resolved.plugin_name, hook = %resolved.hook_name, error = %e, \"prewarm: command refresh failed\");",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    },
