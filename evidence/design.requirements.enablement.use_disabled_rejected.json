{
  "determination": true,
  "inputs": [
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[plugins_entries_match_registry_plugin_names_exactly]",
      "text": [
        "/// A registry plugin's name matches exactly: `use = [\"gateless_plugin\"]`",
        "/// neither wakes the dormant `gateless-plugin` nor is taken for a crate, and",
        "/// `disable = [\"gateless_plugin\"]` does not block it. `auto-enable` is consent",
        "/// for dependencies, so it wakes no registry plugin whatever the spelling.",
        "// {test}`design.requirements.consent.registry_name_exact`",
        "// {test}`design.requirements.consent.auto_enable_dependencies_only`",
        "// {test}`design.requirements.consent.dormant_inactive`",
        "// {test}`design.requirements.consent.use_wakes_dormant`",
        "// {test}`design.requirements.consent.unresolved_use_skipped`",
        "// {test}`design.requirements.enablement.use_disabled_rejected`",
        "#[tokio::test]",
        "async fn plugins_entries_match_registry_plugin_names_exactly() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"dormant-plugin0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "            let woken = || !find_installed_skills(&skills_dir, \"gateless-guidance\").is_empty();",
        "",
        "            ctx.sym.config.plugins.auto_enable = vec![\"gateless-plugin\".into()];",
        "            ctx.sym.config.plugins.used = vec![UseEntry::Global(\"gateless_plugin\".into())];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(!woken(), \"auto-enable and a folded `use` spelling\");",
        "",
        "            ctx.sym.config.plugins.auto_enable.clear();",
        "            ctx.sym.config.plugins.used.clear();",
        "            ctx.sym.config.plugins.disable = vec![\"gateless_plugin\".into()];",
        "            ctx.symposium(&[\"use\", \"gateless-plugin\"]).await?;",
        "            assert!(woken(), \"a folded `disable` spelling\");",
        "",
        "            ctx.symposium(&[\"use\", \"--remove\", \"gateless-plugin\"])",
        "                .await?;",
        "            ctx.sym.config.plugins.disable = vec![\"gateless-plugin\".into()];",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"gateless-plugin\"])",
        "                .await",
        "                .expect_err(\"the exact `disable` spelling blocks it\");",
        "            assert!(err.to_string().contains(\"[plugins] disable\"), \"{err}\");",
        "            assert!(!woken());",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[use_on_a_disabled_plugin_errors]",
      "text": [
        "/// `disable` is the last word, so `use` on a declined plugin is refused",
        "/// rather than recorded. Recording it would report success and then install",
        "/// nothing, since activation refuses the plugin too.",
        "// {test}`design.requirements.enablement.use_disabled_rejected`",
        "#[tokio::test]",
        "async fn use_on_a_disabled_plugin_errors() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            symposium::discovery::apply_consent(&mut ctx.sym, &[], &[\"crate-a\".to_string()])?;",
        "",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"crate-a\"])",
        "                .await",
        "                .expect_err(\"a disabled plugin cannot be enabled by name\");",
        "            assert!(",
        "                err.to_string().contains(\"disabled in `[plugins] disable`\"),",
        "                \"{err}\"",
        "            );",
        "            let config = read_config(&ctx);",
        "            assert!(!config.contains(\"use = \"), \"nothing recorded: {config}\");",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "src/use_command.rs",
      "rust_item": "fn[use_plugin]",
      "text": [
        "/// Record an enablement for `name` and sync so its skills install now.",
        "pub async fn use_plugin(",
        "    sym: &mut Symposium,",
        "    cwd: &Path,",
        "    name: &str,",
        "    global: bool,",
        "    update: UpdateLevel,",
        ") -> Result<()> {",
        "    let deps = sym.workspace(cwd);",
        "    let pms = deps.pms();",
        "    let registry = crate::plugins::load_registry(sym).await;",
        "    let id = match pms",
        "        .identify(&registry.plugins, name, UpdateLevel::Check)",
        "        .await",
        "    {",
        "        Ok(id) => id,",
        "        Err(e) => bail!(\"{e} (try `cargo agents search {name}`)\"),",
        "    };",
        "",
        "    // `disable` outranks every way of enabling a plugin, `use` included, so",
        "    // recording an entry here would report success and then install nothing.",
        "    // Re-enabling is dropping the `disable` entry, which is a deliberate edit",
        "    // rather than something `use` undoes on the user's behalf.",
        "    if sym",
        "        .config",
        "        .plugins",
        "        .is_disabled(pms, &PackageId::any_version(&id.pm, name))",
        "    {",
        "        bail!(\"`{name}` is disabled in `[plugins] disable`; remove that entry to enable it again\");",
        "    }",
        "",
        "    // A configured registry is a trust root: what it offers is already",
        "    // enabled by configuration, so there is nothing to record. The exception",
        "    // is a dormant plugin, for which `use` is exactly the wake-up call.",
        "    let registry_plugin = registry",
        "        .plugins",
        "        .iter()",
        "        .find(|p| pms.identity(&p.canonical) == id);",
        "    let dormant = registry_plugin.is_some_and(|p| p.manifest.requires_use);",
        "    let already_trusted = registry_plugin.is_some() && !dormant;",
        "    if already_trusted {",
        "        tracing::info!(",
        "            report = %ReportEvent::Info {",
        "                message: format!(",
        "                    \"`{name}` is already available from a configured registry; nothing to enable\"",
        "                ),",
        "            },",
        "        );",
        "        return Ok(());",
        "    }",
        "",
        "    let workspace_root = deps.root().await.map(Path::to_path_buf);",
        "    if !global && let Err(e) = deps.require_info().await {",
        "        bail!(\"{e}; pass --global to enable `{name}` everywhere\");",
        "    }",
        "",
        "    let entry = match &workspace_root {",
        "        _ if global => UseEntry::Global(name.to_string()),",
        "        Some(root) => UseEntry::Workspace {",
        "            name: name.to_string(),",
        "            workspace: root.clone(),",
        "        },",
        "        None => unreachable!(\"checked above\"),",
        "    };",
        "",
        "    let mut already_enabled = false;",
        "    for e in &sym.config.plugins.used {",
        "        if in_scope(e, global, workspace_root.as_deref())",
        "            && names(pms, &registry.plugins, e.name(), name, Some(&id)).await",
        "        {",
        "            already_enabled = true;",
        "            break;",
        "        }",
        "    }",
        "    if already_enabled {",
        "        tracing::info!(",
        "            report = %ReportEvent::Info {",
        "                message: format!(\"`{name}` is already enabled; nothing changed\"),",
        "            },",
        "        );",
        "    } else {",
        "        sym.config.plugins.used.push(entry);",
        "        sym.save_config().context(\"failed to write user config\")?;",
        "        tracing::info!(",
        "            report = %ReportEvent::PluginEnabled {",
        "                name: name.to_string(),",
        "                global,",
        "            },",
        "        );",
        "    }",
        "",
        "    // Install now rather than waiting for the next sync.",
        "    if workspace_root.is_some() {",
        "        crate::sync::sync(sym, &deps, update).await?;",
        "    }",
        "    Ok(())",
        "}"
      ]
    }
  ],
  "rationale": "Right after identification, `use_plugin` checks `sym.config.plugins.is_disabled(pms, &PackageId::any_version(&id.pm, name))` and bails with ``{name}` is disabled in `[plugins] disable`...`` before building an entry or saving the config. `is_disabled` compares under the owning package manager's rule (cargo folds `-`/`_`, registries compare exactly), so a disable entry naming the same package blocks it.\n\nTests (pass): `use_on_a_disabled_plugin_errors` records `crate-a` in `disable` via `apply_consent`, then asserts `use crate-a` fails with the disable message and the config contains no `use = ` entry; `plugins_entries_match_registry_plugin_names_exactly` asserts the exact `disable = [\"gateless-plugin\"]` spelling makes `use gateless-plugin` fail and nothing wakes (and that a non-matching folded spelling does not block, consistent with \"names the package\").",
  "requirement": "`cargo agents use <name>` MUST fail without changing the config when `[plugins] disable` names the package."
}
