    {
      "rust_file": "src/discovery.rs",
      "rust_item": "fn[enabled_dependencies]",
      "text": [
        "/// The packages whose plugins the user has enabled, to load at sync time.",
        "/// Two sources:",
        "///",
        "/// 1. workspace **dependencies** covered by `[plugins] auto-enable` or an",
        "///    applicable `use` entry, and",
        "/// 2. packages named by a `use` entry that are **not** dependencies:",
        "///    `cargo agents use <crate>` pulls a plugin in from crates.io whether or",
        "///    not the workspace depends on it.",
        "///",
        "/// `auto-enable` intentionally contributes only (1): it is consent for what a",
        "/// dependency you already have carries, not a way to add crates. Declined",
        "/// packages are pruned. A `use` name is resolved through the package managers",
        "/// ([`PmRegistry::identify`]) at `update`: one that names a plugin in",
        "/// `registry` is left out, since that plugin is loaded already and",
        "/// [`used_plugins`] wakes it, and one that no package manager has is skipped.",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.disable_wins`",
        "// {impl}`design.requirements.consent.scoped_use`",
        "// {impl}`design.requirements.consent.use_beyond_dependencies`",
        "// {impl}`design.requirements.consent.auto_enable_dependencies_only`",
        "// {impl}`design.requirements.consent.crate_name_matching`",
        "// {impl}`design.requirements.consent.registry_use_not_dependency_consent`",
        "// {impl}`design.requirements.consent.unresolved_use_skipped`",
        "// {impl}`design.requirements.consent.enabled_once`",
        "pub async fn enabled_dependencies(",
        "    sym: &Symposium,",
        "    pms: &PmRegistry,",
        "    registry: &[Plugin],",
        "    dep_ids: &[PackageId],",
        "    workspace_root: &Path,",
        "    update: UpdateLevel,",
        ") -> Vec<PackageId> {",
        "    let plugins = &sym.config.plugins;",
        "    let used = resolve_used(sym, pms, registry, workspace_root, update).await;",
        "    let mut enabled = Vec::new();",
        "    let mut known = HashSet::new();",
        "    for id in dep_ids.iter().filter(|id| id.pm == CARGO_PM) {",
        "        let identity = pms.identity(id);",
        "        let is_used = used.iter().any(|(_, used)| *used == identity);",
        "        known.insert(identity);",
        "        if !plugins.is_disabled(pms, id) && (plugins.is_auto_enabled(pms, id) || is_used) {",
        "            enabled.push(PackageId::any_version(&id.pm, &id.name));",
        "        }",
        "    }",
        "",
        "    for (name, id) in used {",
        "        let named = PackageId::any_version(&id.pm, name);",
        "        if !registry.iter().any(|p| pms.identity(&p.canonical) == id)",
        "            && !plugins.is_disabled(pms, &named)",
        "            && known.insert(id)",
        "        {",
        "            enabled.push(named);",
        "        }",
        "    }",
        "",
        "    enabled",
        "}"
      ]
    },
    {
      "rust_file": "src/discovery.rs",
      "rust_item": "fn[resolve_used]",
      "text": [
        "// {impl}`design.requirements.consent.scoped_use`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "// {impl}`design.requirements.consent.unresolved_use_skipped`",
        "// {impl}`design.requirements.consent.use_resolves_registry_first`",
        "pub(crate) async fn resolve_used<'a>(",
        "    sym: &'a Symposium,",
        "    pms: &PmRegistry,",
        "    registry: &[Plugin],",
        "    workspace_root: &Path,",
        "    update: UpdateLevel,",
        ") -> Vec<(&'a str, PackageId)> {",
        "    let mut used = Vec::new();",
        "    for name in sym.config.plugins.used_names_in(workspace_root) {",
        "        match pms.identify(registry, name, update).await {",
        "            Ok(id) => used.push((name, id)),",
        "            Err(e) => tracing::warn!(error = %e, \"skipping `[plugins] use` entry\"),",
        "        }",
        "    }",
        "    used",
        "}"
      ]
    },
    {
      "rust_file": "src/discovery.rs",
      "rust_item": "mod[tests]/fn[resolving_use_entries_without_update_stays_offline]",
      "text": [
        "    /// Hook dispatch, `--help` and subcommand dispatch build the active set at",
        "    /// `UpdateLevel::None`, so a `use` entry for a crate that is neither a",
        "    /// dependency nor cached is skipped without a crates.io search or a cargo",
        "    /// process; `sync` resolves it at `Check`.",
        "    // {test}`design.requirements.consent.offline_resolution`",
        "    // {test}`design.requirements.consent.unresolved_use_skipped`",
        "    #[tokio::test]",
        "    async fn resolving_use_entries_without_update_stays_offline() {",
        "        let tmp = tempfile::tempdir().unwrap();",
        "        let sym = sym_with(",
        "            tmp.path(),",
        "            indoc! {r#\"",
        "                [plugins]",
        "                use = [\"published-crate\"]",
        "            \"#},",
        "        );",
        "        let registry = crate::plugins::load_registry(&sym).await;",
        "        let (cargo, network) = crate::test_utils::FakeCargo::instance(&[], &[\"published-crate\"]);",
        "        let pms = PmRegistry::new(vec![cargo]);",
        "        let active_at = async |update| {",
        "            let mut ctx = crate::predicate::PredicateContext::new(&[]);",
        "            crate::plugins::active_plugins(",
        "                &sym,",
        "                &registry,",
        "                &pms,",
        "                Some(tmp.path()),",
        "                &mut ctx,",
        "                update,",
        "            )",
        "            .await",
        "        };",
        "",
        "        active_at(UpdateLevel::None).await;",
        "        assert_eq!(network.load(std::sync::atomic::Ordering::SeqCst), 0);",
        "",
        "        active_at(UpdateLevel::Check).await;",
        "        assert_eq!(network.load(std::sync::atomic::Ordering::SeqCst), 2);",
        "    }"
      ]
    },
    {
      "rust_file": "src/discovery.rs",
      "rust_item": "mod[tests]/fn[use_enables_a_non_dependency_crate_but_auto_enable_does_not]",
      "text": [
        "    /// `use`-ing a crate that isn't a workspace dependency still enables it, so",
        "    /// sync loads its plugin from the registry. `auto-enable` does not: it is",
        "    /// consent for dependencies you already have. A `use` name no package",
        "    /// manager has is skipped.",
        "    // {test}`design.requirements.consent.use_beyond_dependencies`",
        "    // {test}`design.requirements.consent.auto_enable_dependencies_only`",
        "    // {test}`design.requirements.consent.unresolved_use_skipped`",
        "    // {test}`design.requirements.consent.scoped_use`",
        "    #[tokio::test]",
        "    async fn use_enables_a_non_dependency_crate_but_auto_enable_does_not() {",
        "        let tmp = tempfile::tempdir().unwrap();",
        "        let sym = sym_with(",
        "            tmp.path(),",
        "            indoc! {r#\"",
        "                [plugins]",
        "                auto-enable = [\"not-a-dep-autoenable\"]",
        "                use = [\"my-skills-crate\", \"ghost\", { name = \"scoped-crate\", workspace = \"/elsewhere\" }]",
        "            \"#},",
        "        );",
        "        // Only `anyhow` is an actual dependency; the rest are not.",
        "        let deps = [PackageId::new(CARGO_PM, \"anyhow\", \"1.0.0\")];",
        "",
        "        // The `use`d non-dependency crate is enabled; the workspace-scoped one",
        "        // (for /elsewhere), the unknown one and the auto-enabled",
        "        // non-dependency are not.",
        "        assert_eq!(",
        "            enabled_names(&sym, &deps, tmp.path()).await,",
        "            vec![\"my-skills-crate\".to_string()]",
        "        );",
        "    }"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[plugins_entries_match_registry_plugin_names_exactly]",
      "text": [
        "/// A registry plugin's name matches exactly: `use = [\"gateless_plugin\"]`",
        "/// neither wakes the dormant `gateless-plugin` nor is taken for a crate, and",
        "/// `disable = [\"gateless_plugin\"]` does not block it. `auto-enable` is consent",
        "/// for dependencies, so it wakes no registry plugin whatever the spelling.",
        "// {test}`design.requirements.consent.registry_name_exact`",
        "// {test}`design.requirements.consent.auto_enable_dependencies_only`",
        "// {test}`design.requirements.consent.dormant_inactive`",
        "// {test}`design.requirements.consent.use_wakes_dormant`",
        "// {test}`design.requirements.consent.unresolved_use_skipped`",
        "// {test}`design.requirements.enablement.use_disabled_rejected`",
        "#[tokio::test]",
        "async fn plugins_entries_match_registry_plugin_names_exactly() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"dormant-plugin0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "            let woken = || !find_installed_skills(&skills_dir, \"gateless-guidance\").is_empty();",
        "",
        "            ctx.sym.config.plugins.auto_enable = vec![\"gateless-plugin\".into()];",
        "            ctx.sym.config.plugins.used = vec![UseEntry::Global(\"gateless_plugin\".into())];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(!woken(), \"auto-enable and a folded `use` spelling\");",
        "",
        "            ctx.sym.config.plugins.auto_enable.clear();",
        "            ctx.sym.config.plugins.used.clear();",
        "            ctx.sym.config.plugins.disable = vec![\"gateless_plugin\".into()];",
        "            ctx.symposium(&[\"use\", \"gateless-plugin\"]).await?;",
        "            assert!(woken(), \"a folded `disable` spelling\");",
        "",
        "            ctx.symposium(&[\"use\", \"--remove\", \"gateless-plugin\"])",
        "                .await?;",
        "            ctx.sym.config.plugins.disable = vec![\"gateless-plugin\".into()];",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"gateless-plugin\"])",
        "                .await",
        "                .expect_err(\"the exact `disable` spelling blocks it\");",
        "            assert!(err.to_string().contains(\"[plugins] disable\"), \"{err}\");",
        "            assert!(!woken());",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[status_reports_a_pluginless_dependency_only_when_used]",
      "text": [
        "// {test}`design.requirements.consent.unresolved_use_skipped`",
        "// {test}`design.requirements.enablement.status_state`",
        "#[tokio::test]",
        "async fn status_reports_a_pluginless_dependency_only_when_used() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"plain-dep0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let workspace_root = ctx.workspace_root.clone().unwrap();",
        "            ctx.sym.config.plugins.auto_enable = vec![\"*\".into()];",
        "            ctx.sym",
        "                .config",
        "                .plugins",
        "                .used",
        "                .push(symposium::config::UseEntry::Global(\"not-a-dep\".into()));",
        "",
        "            let deps = ctx.sym.workspace(&workspace_root);",
        "            let entries = symposium::status_command::workspace_status(&ctx.sym, &deps).await?;",
        "            assert!(",
        "                !entries.iter().any(|e| e.name == \"plain-dep\"),",
        "                \"{entries:?}\"",
        "            );",
        "            let crate_a = entries",
        "                .iter()",
        "                .find(|e| e.name == \"crate-a\")",
        "                .expect(\"crate-a present\");",
        "            assert_eq!(crate_a.state, StatusState::Active);",
        "            assert_eq!(crate_a.root, \"`[plugins] auto-enable`\");",
        "            let not_a_dep = entries",
        "                .iter()",
        "                .find(|e| e.name == \"not-a-dep\")",
        "                .expect(\"not-a-dep present\");",
        "            assert_eq!(not_a_dep.state, StatusState::Dormant);",
        "            assert!(not_a_dep.root.contains(\"cached crate\"), \"{not_a_dep:?}\");",
        "",
        "            ctx.sym.config.plugins.auto_enable.clear();",
        "            ctx.symposium(&[\"use\", \"plain-dep\"]).await?;",
        "            let deps = ctx.sym.workspace(&workspace_root);",
        "            let entries = symposium::status_command::workspace_status(&ctx.sym, &deps).await?;",
        "            let plain = entries",
        "                .iter()",
        "                .find(|e| e.name == \"plain-dep\")",
        "                .expect(\"plain-dep present once used\");",
        "            assert_eq!(plain.state, StatusState::Dormant);",
        "            assert!(!plain.root.contains(\"not a dependency\"), \"{plain:?}\");",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    }
  ],
  "rationale": "`resolve_used` matches on `pms.identify(..)`: `Ok(id)` is kept, `Err(e)` (\"no package named ...\", when no registry plugin and no package manager has the name) is logged with `tracing::warn!` and the loop continues; the function returns a plain `Vec`, never an error. `enabled_dependencies` only iterates what `resolve_used` returned, so the unresolved entry contributes nothing and the caller (`active_plugins`, `discover`, `status`) proceeds normally.\n\nTests (all pass): `discovery::tests::use_enables_a_non_dependency_crate_but_auto_enable_does_not` (`ghost` is skipped; the result is just `my-skills-crate`); `discovery::tests::resolving_use_entries_without_update_stays_offline` (uncached `published-crate` at `None` is skipped and `active_plugins` completes); `tests/enablement.rs` `plugins_entries_match_registry_plugin_names_exactly` (`use = [\"gateless_plugin\"]`, which no package manager has, does not make `sync` fail) and `status_reports_a_pluginless_dependency_only_when_used` (`status` succeeds with an extra `use` entry and auto-enable).",
  "requirement": "Symposium MUST skip, without failing, a `[plugins] use` entry that no package manager resolves."
}
