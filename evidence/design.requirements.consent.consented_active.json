      "rust_file": "src/discovery.rs",
      "rust_item": "fn[decide]",
      "text": [
        "/// Classify one offer against the `[plugins]` config. `disable` outranks every",
        "/// other entry, and an explicit `use` outranks the standing `auto-enable`, so a",
        "/// name the user declined stays declined.",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.disable_wins`",
        "// {impl}`design.requirements.consent.crate_name_matching`",
        "// {impl}`design.requirements.consent.registry_use_not_dependency_consent`",
        "// {impl}`design.requirements.enablement.status_state`",
        "fn decide(",
        "    sym: &Symposium,",
        "    pms: &PmRegistry,",
        "    used: &HashSet<PackageId>,",
        "    id: &PackageId,",
        ") -> Enablement {",
        "    let plugins = &sym.config.plugins;",
        "    // `disable` is tested first because it is the last word: every other",
        "    // entry says a plugin *may* run, and this is the only one that says it",
        "    // may not. Activation agrees (see `record_active`), so classifying a",
        "    // disabled plugin as `Used` here would report it active while it stays",
        "    // off.",
        "    if plugins.is_disabled(pms, id) {",
        "        Enablement::Declined",
        "    } else if used.contains(&pms.identity(id)) {",
        "        Enablement::Used",
        "    } else if plugins.is_auto_enabled(pms, id) {",
        "        Enablement::AutoEnabled",
        "    } else {",
        "        Enablement::Candidate",
        "    }",
        "}"
      ]
    },
