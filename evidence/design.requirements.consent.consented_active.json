        "        let sym = sym_with(",
        "            tmp.path(),",
        "            indoc! {r#\"",
        "                [plugins]",
        "                auto-enable = [\"widget_lib\"]",
        "            \"#},",
        "        );",
        "",
        "        let found = discover(&sym, &ws, &[]).await;",
        "        assert!(found.candidates.is_empty());",
        "        let names: Vec<&str> = found.auto_enabled.iter().map(|c| c.name()).collect();",
