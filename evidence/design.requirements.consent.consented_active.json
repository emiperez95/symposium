      "rust_file": "src/hook.rs",
      "rust_item": "fn[discovery_hint]",
      "text": [
        "/// Suggest `cargo agents --help` when the active workspace exposes crate-aware plugin subcommands.",
        "/// Reuses the help renderer's `applicable_subcommands`, so the hint fires only when there is actually something to discover; `None` otherwise.",
        "// {impl}`design.requirements.hooks.discovery_hint`",
        "// {impl}`design.requirements.hooks.discovery_hint_audience`",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.dormant_inactive`",
        "// {impl}`design.requirements.consent.use_wakes_dormant`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "async fn discovery_hint(sym: &Symposium, deps: &Arc<Workspace>) -> Option<String> {",
        "    let workspace = deps.info().await.cloned();",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, workspace.as_ref()).await;",
        "    let dep_ids = deps.dep_ids().await.to_vec();",
        "",
        "    let pms = deps.pms();",
        "    let used = workspace",
        "        .as_ref()",
        "        .map(|ws| crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root))",
        "        .unwrap_or_default();",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    let active = crate::plugins::active_plugins(",
        "        sym,",
        "        &registry,",
        "        pms,",
        "        workspace.as_ref().map(|ws| ws.root.as_path()),",
        "        &mut ctx,",
        "        symposium_install::UpdateLevel::None,",
        "    )",
        "    .await;",
        "    let any_subcommand = !applicable_subcommands(&active, &dep_ids, &used).is_empty();",
        "",
        "    any_subcommand.then(|| {",
        "        format!(",
        "            \"This project has crate-aware tools available via `cargo agents`. \\",
        "             Run `cargo agents --help` to list them before working with the Rust code. \\",
        "             Only use tools under the '{AGENTS_HEADING}' section unless the user \\",
        "             explicitly asks you to run one from '{HUMANS_HEADING}'.\"",
        "        )",
        "    })",
        "}"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[dispatch_plugin_hooks]",
      "text": [
        "/// Dispatch plugin hooks with format routing.",
        "///",
        "/// Accumulates output as `serde_json::Value` in the host agent's wire format.",
        "/// When a plugin's format matches the host agent, input/output pass through directly.",
        "/// When formats differ, conversion goes through symposium canonical types.",
        "/// `prior_context` is the context already in `prior_output`; every hook's",
        "/// context is added to it (see [`JoinedContext`]).",
        "///",
        "/// Returns `Ok(json)` on success, `Err(stderr)` on exit code 2.",
        "#[allow(clippy::too_many_arguments)]",
        "// {impl}`design.requirements.hooks.hook_gating`",
        "// {impl}`design.requirements.hooks.native_input`",
        "// {impl}`design.requirements.hooks.native_output`",
        "// {impl}`design.requirements.hooks.canonical_input`",
        "// {impl}`design.requirements.hooks.canonical_output`",
        "// {impl}`design.requirements.hooks.raw_json_fallback`",
        "// {impl}`design.requirements.hooks.hook_stdin_payload`",
        "// {impl}`design.requirements.hooks.merge_later_wins`",
        "// {impl}`design.requirements.hooks.joined_context`",
        "// {impl}`design.requirements.hooks.deny_final`",
        "// {impl}`design.requirements.hooks.exit_2_stops`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.dormant_inactive`",
        "// {impl}`design.requirements.consent.use_wakes_dormant`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "pub async fn dispatch_plugin_hooks(",
        "    sym: &Symposium,",
        "    host_agent: HookAgent,",
        "    event: HookEvent,",
        "    sym_input: &symposium::InputEvent,",
        "    original_input: &dyn AgentHookInput,",
        "    prior_output: serde_json::Value,",
        "    prior_context: Option<String>,",
        "    deps: &Arc<Workspace>,",
        ") -> Result<serde_json::Value, Vec<u8>> {",
        "    let workspace = deps.info().await.cloned();",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, workspace.as_ref()).await;",
        "",
        "    // Resolving the workspace means running cargo, so only do it when some",
        "    // plugin's hook gating references a concrete crate (a `depends-on(*)`",
        "    // wildcard or env/shell/path predicate never needs the crate graph), or",
        "    // when there is crate-plugin expansion to perform — that too evaluates",
        "    // predicates against the crate graph.",
        "    let dep_ids = if hook_dispatch_needs_deps(sym, &registry.plugins) {",
        "        deps.dep_ids().await.to_vec()",
        "    } else {",
        "        Vec::new()",
        "    };",
        "    let pms = deps.pms();",
        "    let used = workspace",
        "        .as_ref()",
        "        .map(|ws| crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root))",
        "        .unwrap_or_default();",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    // Dispatch over the active set — registry plugins plus crate-sourced ones —",
        "    // so a crate plugin's hooks fire exactly like a registry plugin's.",
        "    let plugins = crate::plugins::active_plugins(",
        "        sym,",
        "        &registry,",
        "        pms,",
        "        workspace.as_ref().map(|ws| ws.root.as_path()),",
        "        &mut ctx,",
        "        symposium_install::UpdateLevel::None,",
        "    )",
        "    .await;",
        "    let hooks = dispatched_hooks_for_payload(&plugins, sym_input, host_agent, &mut ctx);",
        "",
        "    let mut output = prior_output;",
        "    let mut context = JoinedContext::new(event, prior_context);",
        "",
        "    for hook in hooks {",
        "        tracing::info!(",
        "            plugin = %hook.plugin_name,",
        "            hook = %hook.hook_name,",
        "            format = ?hook.format,",
        "            \"running plugin hook\"",
        "        );",
        "",
        "        // Determine stdin for the plugin based on its declared format.",
        "        // After format selection, the only two cases are:",
        "        // - native (matches host agent) → pass through original input",
        "        // - symposium → deliver canonical format",
        "        let hook_agent = hook.format.as_agent();",
        "        let hook_input: &dyn AgentHookInput = if hook_agent == Some(host_agent) {",
        "            original_input",
        "        } else {",
        "            sym_input",
        "        };",
        "        let stdin_str = match hook_input.to_string() {",
        "            Ok(s) => s,",
        "            Err(e) => {",
        "                tracing::error!(plugin = %hook.plugin_name, hook = %hook.hook_name, error = %e, \"failed to serialize hook input\");",
        "                continue;",
        "            }",
        "        };",
        "",
        "        let spawn_res = match build_spawn_spec(sym, &hook).await {",
        "            Ok(spec) => spawn_from_spec(spec),",
        "            Err(e) => {",
        "                tracing::warn!(error = %e, \"failed to prepare hook command\");",
        "                continue;",
        "            }",
        "        };",
        "",
        "        match spawn_res {",
        "            Ok(mut child) => {",
        "                if let Some(mut stdin) = child.stdin.take() {",
        "                    let _ = stdin.write_all(stdin_str.as_bytes());",
        "                }",
        "",
        "                let child_out = match child.wait_with_output() {",
        "                    Ok(o) => o,",
        "                    Err(e) => {",
        "                        tracing::warn!(error = %e, \"failed waiting for hook process\");",
        "                        continue;",
        "                    }",
        "                };",
        "",
        "                tracing::trace!(?child_out, \"hook finished\");",
        "",
        "                let exit_code = child_out.status.code();",
        "                tracing::debug!(",
        "                    report = %crate::report::ReportEvent::HookDispatched {",
        "                        plugin: hook.plugin_name.clone(),",
        "                        hook: hook.hook_name.clone(),",
        "                        exit_code,",
        "                        error: None,",
        "                    },",
        "                );",
        "                match exit_code {",
        "                    None | Some(2) => return Err(child_out.stderr),",
        "                    Some(0) if child_out.stdout.is_empty() => continue,",
        "                    Some(0) => {",
        "                        // Parse output and convert to host agent format.",
        "                        // Two cases: native (same as host) or symposium.",
        "                        let host_handler = crate::hook_schema::agent_event(host_agent, event);",
        "                        let Some(host_h) = host_handler else { continue };",
        "",
        "                        let (host_json, hook_output) = if hook_agent == Some(host_agent) {",
        "                            // Native format — parse as host agent output",
        "                            match host_h.parse_output(&child_out.stdout) {",
        "                                Ok(o) => (o.to_hook_output(), Some(o.to_symposium())),",
        "                                Err(e) => {",
        "                                    tracing::warn!(error = %e, \"failed to parse hook output\");",
        "                                    continue;",
        "                                }",
        "                            }",
        "                        } else {",
        "                            // Symposium format — parse and convert to host agent",
        "                            match serde_json::from_slice::<serde_json::Value>(&child_out.stdout) {",
        "                                Ok(v) => {",
        "                                    if let Ok(sym_out) =",
        "                                        serde_json::from_value::<symposium::OutputEvent>(v.clone())",
        "                                    {",
        "                                        let host_out = host_h.translate_output(&sym_out);",
        "                                        (host_out.to_hook_output(), Some(sym_out))",
        "                                    } else {",
        "                                        (v, None)",
        "                                    }",
        "                                }",
        "                                Err(e) => {",
        "                                    tracing::warn!(error = %e, \"failed to parse hook output\");",
        "                                    continue;",
        "                                }",
        "                            }",
        "                        };",
        "",
        "                        merge(&mut output, host_json);",
        "                        if hook_output.as_ref().is_some_and(denies) {",
        "                            tracing::info!(",
        "                                plugin = %hook.plugin_name,",
        "                                hook = %hook.hook_name,",
        "                                \"plugin hook denied the tool call; later hooks do not run\"",
        "                            );",
        "                            return Ok(output);",
        "                        }",
        "                        context.add(hook_output.as_ref(), &mut output, host_h.as_ref());",
        "                    }",
        "                    Some(code) => {",
        "                        tracing::warn!(",
        "                            exit_code = code,",
        "                            \"plugin hook exited with non-zero (continuing)\"",
        "                        );",
        "                    }",
        "                }",
        "            }",
        "            Err(e) => {",
        "                tracing::debug!(",
        "                    report = %crate::report::ReportEvent::HookDispatched {",
        "                        plugin: hook.plugin_name.clone(),",
        "                        hook: hook.hook_name.clone(),",
        "                        exit_code: None,",
        "                        error: Some(e.to_string()),",
        "                    },",
        "                );",
        "                tracing::warn!(error = %e, \"failed to spawn hook command\");",
        "            }",
        "        }",
        "    }",
        "",
        "    Ok(output)",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[use_records_workspace_entry_and_installs]",
      "text": [
        "/// `use <dep>` records a workspace-scoped entry and installs the",
        "/// dependency's embedded skills right away; running it again changes",
        "/// nothing.",
        "// {test}`design.requirements.consent.unconsented_inactive`",
        "// {test}`design.requirements.consent.consented_active`",
        "// {test}`design.requirements.consent.crate_name_matching`",
        "// {test}`design.requirements.enablement.use_scope`",
        "// {test}`design.requirements.enablement.use_idempotent`",
        "// {test}`design.requirements.enablement.use_syncs`",
        "#[tokio::test]",
        "async fn use_records_workspace_entry_and_installs() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "",
        "            // Unconsented, the dependency's skills stay out.",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(find_installed_skills(&skills_dir, \"a-guidance\").is_empty());",
        "",
        "            ctx.symposium(&[\"use\", \"crate-a\"]).await?;",
        "            find_installed_skill(&skills_dir, \"a-guidance\");",
        "",
        "            let config = read_config(&ctx);",
        "            assert!(config.contains(\"crate-a\"), \"entry recorded: {config}\");",
        "            assert!(",
        "                config.contains(\"workspace\"),",
        "                \"entry is workspace-scoped: {config}\"",
        "            );",
        "",
        "            ctx.symposium(&[\"use\", \"crate-a\"]).await?;",
        "            assert_eq!(config, read_config(&ctx), \"re-using must not duplicate\");",
        "            ctx.symposium(&[\"use\", \"crate_a\"]).await?;",
        "            assert_eq!(",
        "                config,",
        "                read_config(&ctx),",
        "                \"another spelling must not duplicate\"",
        "            );",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[plugins_entries_match_crate_names_like_cargo]",
      "text": [
        "/// A crate name matches the way cargo matches it, so `crate_a` names the",
        "/// dependency `crate-a` in `auto-enable`, `use` and `disable` alike.",
        "// {test}`design.requirements.consent.crate_name_matching`",
        "// {test}`design.requirements.consent.consented_active`",
        "// {test}`design.requirements.consent.disable_wins`",
        "#[tokio::test]",
        "async fn plugins_entries_match_crate_names_like_cargo() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "            let installed = || !find_installed_skills(&skills_dir, \"a-guidance\").is_empty();",
        "",
        "            ctx.sym.config.plugins.auto_enable = vec![\"crate_a\".into()];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(installed(), \"auto-enable\");",
        "",
        "            ctx.sym.config.plugins.auto_enable.clear();",
        "            ctx.sym.config.plugins.used = vec![UseEntry::Global(\"crate_a\".into())];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(installed(), \"use\");",
        "",
        "            ctx.sym.config.plugins.used.clear();",
        "            ctx.sym.config.plugins.auto_enable = vec![\"*\".into()];",
        "            ctx.sym.config.plugins.disable = vec![\"crate_a\".into()];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(!installed(), \"disable\");",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[apply_consent_records_both_answers]",
      "text": [
        "/// Recorded consent is durable in both directions: approval enables and the",
        "/// candidate stops being offered; a decline is remembered too.",
        "// {test}`design.requirements.consent.consented_active`",
        "// {test}`design.requirements.consent.approval_recorded`",
        "// {test}`design.requirements.consent.decline_recorded`",
        "#[tokio::test]",
        "async fn apply_consent_records_both_answers() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let workspace_root = ctx.workspace_root.clone().unwrap();",
        "",
        "            symposium::discovery::apply_consent(&mut ctx.sym, &[\"crate-a\".to_string()], &[])?;",
        "            assert!(read_config(&ctx).contains(\"auto-enable\"));",
        "",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            find_installed_skill(&workspace_root.join(\".claude/skills\"), \"a-guidance\");",
        "",
        "            let deps = ctx.sym.workspace(&workspace_root);",
        "            assert!(",
        "                symposium::discovery::pending_candidates(&ctx.sym, &deps)",
        "                    .await",
        "                    .is_empty(),",
        "                \"a decided dependency is not offered again\"",
        "            );",
        "",
        "            symposium::discovery::apply_consent(&mut ctx.sym, &[], &[\"other-dep\".to_string()])?;",
        "            assert!(read_config(&ctx).contains(\"disable\"));",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    }
  ],
  "rationale": "Activation path: every activating caller (`sync` via `skills.rs`, `hook::dispatch_plugin_hooks`, `hook::prewarm_hook_sources`, `hook::discovery_hint`, `help_render`, `subcommand_dispatch`, `status`) builds the active set with `plugins::active_plugins`, which seeds only the trust-root registry/workspace plugins (gated by `record_active` -> `Plugin::applies`) plus the ids returned by `discovery::enabled_dependencies`, then follows `[[plugins]]` chain edges of already-active plugins. No other route loads a dependency-embedded plugin.\n\n- `enabled_dependencies`: for each cargo dependency, `plugins.is_auto_enabled(pms, id) || is_used` (an applicable `use` entry resolved by `resolve_used` to the same `pms.identity`) and `!plugins.is_disabled` -> pushes `PackageId::any_version(cargo, name)`. `active_plugins` puts that id on its worklist, `pms.load_plugin(id, update)` builds the crate plugin (cache-only at `None`; a workspace dependency is served from the source `cargo metadata` extracted, so it is always available), and `record_active` appends it to the active set, so its skills (sync), hooks (`dispatch_plugin_hooks`, `prewarm_hook_sources`) and subcommands (`discovery_hint`, dispatch) all apply.\n- `decide` reports the same offer as `Used` / `AutoEnabled` when not disabled (disable checked first).\n\nTests (all pass): `discovery::tests::auto_enable_moves_a_candidate_to_enabled`, `use_entry_and_disable_outrank_the_standing_decisions` (use -> `Used`), `enabled_dependencies_reads_config_not_offers` (`serde` via auto-enable and `tokio` via use are enabled even though no offer was seen); `tests/enablement.rs` `use_records_workspace_entry_and_installs` (after `use crate-a`, the `a-guidance` skill installs), `plugins_entries_match_crate_names_like_cargo` (auto-enable and use each install it), `apply_consent_records_both_answers` (approval -> `sync` installs the skill).\n\nLimit: \"activate\" is the consent axis only; the crate plugin's own plugin-level predicates are still evaluated by `Plugin::applies` in `record_active`, which is the separate activation-predicate axis.",
  "requirement": "Symposium MUST activate the plugin embedded in a workspace dependency that `[plugins] auto-enable` or an applicable `[plugins] use` entry names, when `[plugins] disable` does not name it."
}
