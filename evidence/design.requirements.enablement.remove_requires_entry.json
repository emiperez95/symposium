      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[use_remove_reaps_and_then_errors]",
      "text": [
        "/// `--remove` drops the entry, reaps the installed skills, and errors when",
        "/// there is nothing left to remove.",
        "// {test}`design.requirements.enablement.use_syncs`",
        "// {test}`design.requirements.enablement.remove_requires_entry`",
        "#[tokio::test]",
        "async fn use_remove_reaps_and_then_errors() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "",
        "            ctx.symposium(&[\"use\", \"crate-a\"]).await?;",
        "            find_installed_skill(&skills_dir, \"a-guidance\");",
        "",
        "            ctx.symposium(&[\"use\", \"--remove\", \"crate-a\"]).await?;",
        "            assert!(",
        "                !read_config(&ctx).contains(\"crate-a\"),",
        "                \"entry removed: {}\",",
        "                read_config(&ctx)",
        "            );",
        "            assert!(",
        "                find_installed_skills(&skills_dir, \"a-guidance\").is_empty(),",
        "                \"skills reaped after removal\"",
        "            );",
        "",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"--remove\", \"crate-a\"])",
        "                .await",
        "                .expect_err(\"nothing left to remove\");",
        "            assert!(err.to_string().contains(\"no `use` entry\"), \"{err}\");",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[use_remove_respects_scope]",
      "text": [
        "/// `--remove --global` targets only the global entry, leaving a",
        "/// workspace-scoped one alone.",
        "// {test}`design.requirements.enablement.use_scope`",
        "// {test}`design.requirements.enablement.remove_requires_entry`",
        "#[tokio::test]",
        "async fn use_remove_respects_scope() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            ctx.symposium(&[\"use\", \"crate-a\"]).await?;",
        "",
        "            let err = ctx",
        "                .symposium(&[\"use\", \"--remove\", \"--global\", \"crate-a\"])",
        "                .await",
        "                .expect_err(\"no global entry to remove\");",
        "            assert!(err.to_string().contains(\"no `use` entry\"), \"{err}\");",
        "            assert!(",
        "                read_config(&ctx).contains(\"crate-a\"),",
        "                \"workspace entry untouched\"",
        "            );",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "src/use_command.rs",
      "rust_item": "fn[remove_plugin]",
      "text": [
        "/// Drop a previously recorded enablement and re-sync so the plugin's skills",
        "/// are reaped now.",
        "///",
        "/// The scope must match: without `--global` this removes the entry recorded",
        "/// for the current workspace, with it the unscoped entry. A scope mismatch is",
        "/// an error rather than a silent success.",
        "pub async fn remove_plugin(",
        "    sym: &mut Symposium,",
        "    cwd: &Path,",
        "    name: &str,",
        "    global: bool,",
        "    update: UpdateLevel,",
        ") -> Result<()> {",
        "    let deps = sym.workspace(cwd);",
        "    let workspace_root = deps.root().await.map(Path::to_path_buf);",
        "    let pms = deps.pms();",
        "    let registry = crate::plugins::load_registry(sym).await;",
        "    let id = pms",
        "        .identify(&registry.plugins, name, UpdateLevel::Check)",
        "        .await",
        "        .ok();",
        "",
        "    let used = std::mem::take(&mut sym.config.plugins.used);",
        "    let before = used.len();",
        "    for entry in used {",
        "        let remove = in_scope(&entry, global, workspace_root.as_deref())",
        "            && names(pms, &registry.plugins, entry.name(), name, id.as_ref()).await;",
        "        if !remove {",
        "            sym.config.plugins.used.push(entry);",
        "        }",
        "    }",
        "    if sym.config.plugins.used.len() == before {",
        "        let scope = if global { \"--global\" } else { \"this workspace\" };",
        "        bail!(\"no `use` entry for `{name}` ({scope}); see `cargo agents status`\");",
        "    }",
        "    sym.save_config().context(\"failed to write user config\")?;",
        "    tracing::info!(",
        "        report = %ReportEvent::PluginRemoved {",
        "            name: name.to_string(),",
        "            global,",
        "        },",
        "    );",
        "",
        "    if workspace_root.is_some() {",
        "        crate::sync::sync(sym, &deps, update).await?;",
        "    }",
        "    Ok(())",
        "}"
      ]
    },
    {
      "rust_file": "src/use_command.rs",
      "rust_item": "fn[in_scope]",
      "text": [
        "fn in_scope(entry: &UseEntry, global: bool, workspace_root: Option<&Path>) -> bool {",
        "    match entry {",
        "        UseEntry::Global(_) => global,",
        "        UseEntry::Workspace { .. } => {",
        "            !global && workspace_root.is_some_and(|root| entry.applies_in(root))",
        "        }",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/use_command.rs",
      "rust_item": "fn[names]",
      "text": [
        "/// Does the `use` entry `entry` name the package `id` that `name` resolved",
        "/// to? An entry or a name that no package manager has matches only as written.",
        "async fn names(",
        "    pms: &PmRegistry,",
        "    plugins: &[Plugin],",
        "    entry: &str,",
        "    name: &str,",
        "    id: Option<&PackageId>,",
        ") -> bool {",
        "    entry == name",
        "        || (id.is_some()",
        "            && pms",
        "                .identify(plugins, entry, UpdateLevel::Check)",
        "                .await",
        "                .ok()",
        "                .as_ref()",
        "                == id)",
        "}"
      ]
    }
  ],
  "rationale": "`remove_plugin` takes the `used` list, keeps every entry for which `in_scope(entry, global, workspace_root) && names(...)` is false, and if the length is unchanged bails with `no `use` entry for `{name}` ({scope})` before calling `save_config`. The in-memory list is rebuilt identically in that case, and nothing is written. `in_scope` restricts matching to the requested scope (Global entries only with `--global`, the current workspace's entries only without it); `names` matches the typed spelling or the same resolved package identity.\n\nTests (pass): `use_remove_reaps_and_then_errors` asserts a second `use --remove crate-a` fails with `no `use` entry`; `use_remove_respects_scope` asserts `use --remove --global crate-a` with only a workspace entry fails and the workspace entry remains in the config file.",
  "requirement": "`cargo agents use --remove <name>` MUST fail without changing the config when no entry in the requested scope names `<name>`."
}
