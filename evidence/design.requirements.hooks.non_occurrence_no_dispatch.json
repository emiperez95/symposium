{
  "determination": true,
  "inputs": [
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[execute_hook]",
      "text": [
        "/// Core hook pipeline: sync → parse → builtin → plugins → serialize.",
        "///",
        "/// Takes the raw agent wire-format input, returns the agent wire-format",
        "/// response. Called by both `run()` (CLI) and the test harness.",
        "// {impl}`design.requirements.hooks.unsupported_event`",
        "// {impl}`design.requirements.hooks.non_occurrence_neutral`",
        "// {impl}`design.requirements.hooks.non_occurrence_no_dispatch`",
        "// {impl}`design.requirements.hooks.auto_sync_session_start`",
        "// {impl}`design.requirements.hooks.source_refresh_session_start`",
        "// {impl}`design.requirements.hooks.joined_context`",
        "// {impl}`design.requirements.hooks.merge_later_wins`",
        "// {impl}`design.requirements.hooks.exit_2_stops`",
        "// {impl}`design.requirements.hooks.block_reason_stderr`",
        "// {impl}`design.requirements.hooks.block_pre_tool_use_deny`",
        "// {impl}`design.requirements.hooks.block_other_exit_2`",
        "// {impl}`design.requirements.hooks.best_effort`",
        "// {impl}`design.requirements.hooks.malformed_payload_fails`",
        "pub async fn execute_hook(",
        "    sym: &Symposium,",
        "    agent: HookAgent,",
        "    event: HookEvent,",
        "    input: &str,",
        ") -> anyhow::Result<HookResponse> {",
        "    let event_handler = crate::hook_schema::agent_event(agent, event);",
        "",
        "    if let Some(handler) = event_handler {",
        "        let payload = handler.parse_input(input)?;",
        "",
        "        // The agent's native event can fire more often than the symposium",
        "        // event it maps to; a payload that is not an occurrence of it gets the",
        "        // agent's neutral output and reaches neither sync nor any hook.",
        "        if !payload.should_dispatch() {",
        "            tracing::debug!(",
        "                ?agent,",
        "                ?event,",
        "                \"payload is not an occurrence of the event, skipping\"",
        "            );",
        "            let neutral = handler.translate_output(&symposium::OutputEvent::empty_for(event));",
        "            return Ok(handler.respond(&neutral.to_hook_output()));",
        "        }",
        "",
        "        let sym_input = payload.to_symposium();",
        "",
        "        // One workspace context for the whole hook invocation: one PM set,",
        "        // one workspace resolution, one dependency list. Auto-sync populates",
        "        // the caches if it runs; later stages read them.",
        "        let fallback_cwd = std::env::current_dir().unwrap_or_default();",
        "        let cwd = match sym_input.cwd() {",
        "            Some(s) => PathBuf::from(s),",
        "            None => fallback_cwd,",
        "        };",
        "        let deps = sym.workspace(&cwd);",
        "",
        "        // Auto-sync: install applicable skills into agent dirs (non-fatal).",
        "        // SessionStart refreshes source caches and syncs unconditionally.",
        "        let session_start = event == HookEvent::SessionStart;",
        "        let notify_about_possible_new_plugins = run_auto_sync(sym, &deps, session_start).await;",
        "",
        "        // SessionStart (once per session) also refreshes every hook's already-",
        "        // cached source, so later events dispatch fresh binaries without per-",
        "        // event network cost. Best-effort; gated by `auto-sync`.",
        "        if session_start && sym.config.auto_sync {",
        "            prewarm_hook_sources(sym, &deps).await;",
        "        }",
        "",
        "        // Builtin dispatch → symposium output → host agent output as Value",
        "        let builtin_sym_output =",
        "            dispatch_builtin(sym, &sym_input, &deps, notify_about_possible_new_plugins).await;",
        "        let builtin_agent_output = handler.translate_output(&builtin_sym_output);",
        "        let prior_output = builtin_agent_output.to_hook_output();",
        "",
        "        // Plugin dispatch with format routing",
        "        let response = match dispatch_plugin_hooks(",
        "            sym,",
        "            agent,",
        "            event,",
        "            &sym_input,",
        "            payload.as_ref(),",
        "            prior_output,",
        "            builtin_sym_output.additional_context().map(String::from),",
        "            &deps,",
        "        )",
        "        .await",
        "        {",
        "            Ok(final_output) => handler.respond(&final_output),",
        "            Err(stderr) => blocked_response(handler.as_ref(), event, &stderr),",
        "        };",
        "        tracing::trace!(",
        "            stdout_len = response.stdout.len(),",
        "            exit_code = response.exit_code,",
        "            \"hook response ready\"",
        "        );",
        "        Ok(response)",
        "    } else {",
        "        // Agent doesn't support this event",
        "        anyhow::bail!(\"agent {agent:?} does not support hook event {event:?}\")",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "tests/plugin_dispatch.rs",
      "rust_item": "fn[later_invocations_of_a_turn_reach_no_plugin_hook]",
      "text": [
        "/// An agent's native event can fire more often than the symposium event it",
        "/// maps to. Antigravity's `PreInvocation` fires before every model call, so",
        "/// only the first of a turn is the prompt event: it reaches the plugin hook,",
        "/// while a later one gets the agent's neutral output and reaches nothing.",
        "#[tokio::test(flavor = \"multi_thread\")]",
        "async fn later_invocations_of_a_turn_reach_no_plugin_hook() {",
        "    with_fixture(TestMode::SimulationOnly, &[\"prompt-hook0\"], async |ctx| {",
        "        let payload = |invocation_num: u32| {",
        "            json!({",
        "                \"invocationNum\": invocation_num,",
        "                \"conversationId\": \"c\",",
        "                \"workspacePaths\": [],",
        "            })",
        "        };",
        "",
        "        let first = ctx",
        "            .invoke_hook(",
        "                HookAgent::Antigravity,",
        "                HookEvent::UserPromptSubmit,",
        "                &payload(0),",
        "            )",
        "            .await?;",
        "        let first = String::from_utf8(first.stdout)?;",
        "        assert!(",
        "            first.contains(\"prompt-hook-ran\"),",
        "            \"the first invocation of a turn is the prompt event, got: {first}\"",
        "        );",
        "",
        "        let later = ctx",
        "            .invoke_hook(",
        "                HookAgent::Antigravity,",
        "                HookEvent::UserPromptSubmit,",
        "                &payload(1),",
        "            )",
        "            .await?;",
        "        assert_eq!(",
        "            String::from_utf8(later.stdout)?,",
        "            r#\"{\"injectSteps\":[]}\"#,",
        "            \"a later invocation is answered neutrally and runs no hook\"",
        "        );",
        "        Ok(())",
        "    })",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    }
  ],
  "rationale": "**Holds.** The `!payload.should_dispatch()` branch in `execute_hook` returns before `run_auto_sync`, `prewarm_hook_sources`, `dispatch_builtin` and `dispatch_plugin_hooks` are reached, so neither auto-sync nor any plugin hook runs.\n\n**Test:** `tests/plugin_dispatch.rs::later_invocations_of_a_turn_reach_no_plugin_hook` (fixture `prompt-hook0`, a prompt hook that prints `prompt-hook-ran`): the first Antigravity invocation of a turn runs the hook, the second's stdout is exactly `{\"injectSteps\":[]}`, so the hook did not run. Passes. The \"no auto-sync\" half is judged from code (the early return); the test does not observe sync.\n",
  "requirement": "When an agent's payload is not an occurrence of the symposium event it maps to, Symposium MUST NOT run auto-sync or any plugin hook."
}
