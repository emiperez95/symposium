        "        \"#}));",
        "        assert!(!dormant_if(indoc! {r#\"",
        "            name = \"p\"",
        "",
        "            [[skills]]",
        "            depends-on = [\"serde\"]",
        "            source.path = \"skills\"",
        "        \"#}));",
        "        assert!(!dormant_if(indoc! {r#\"",
        "            name = \"p\"",
        "",
        "            [[plugins]]",
        "            depends-on = [\"serde\"]",
        "            source.cargo = \"serde-skills\"",
        "        \"#}));",
        "    }"
      ]
