        "/// Built-in hook logic on canonical symposium types.",
        "// {impl}`design.requirements.hooks.builtin_quiet`",
        "// {impl}`design.requirements.hooks.new_plugins_notice`",
        "// {impl}`design.requirements.hooks.discovery_hint`",
