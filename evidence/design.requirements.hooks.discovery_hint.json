        "            handle_user_prompt_submit(sym, prompt, notify_about_possible_new_plugins).await",
        "        }",
        "        symposium::InputEvent::SessionStart(session) => {",
        "            handle_session_start(sym, session, deps).await",
        "        }",
        "        _ => symposium::OutputEvent::empty_for(input.event()),",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[handle_session_start]",
      "text": [
        "/// Handle SessionStart: orient the agent toward crate-aware tooling, name the dependency plugins",
        "/// awaiting consent, and, when due, nudge the user to update. The three fragments are computed",
        "/// independently -- only the update nudge is gated behind the update-check throttle -- then joined",
        "/// into a single context block.",
        "// {impl}`design.requirements.hooks.discovery_hint`",
        "// {impl}`design.requirements.hooks.consent_hint_names`",
        "// {impl}`design.requirements.hooks.update_nudge`",
        "// {impl}`design.requirements.hooks.joined_context`",
        "async fn handle_session_start(",
        "    sym: &Symposium,",
        "    _payload: &SessionStartInput,",
        "    deps: &Arc<Workspace>,",
        ") -> OutputEvent {",
        "    let fragments = [",
        "        discovery_hint(sym, deps).await,",
        "        consent_hint(sym, deps).await,",
        "        update_nudge(sym),",
        "    ]",
        "    .into_iter()",
        "    .flatten()",
        "    .collect::<Vec<String>>();",
        "",
        "    if fragments.is_empty() {",
        "        OutputEvent::empty_for(HookEvent::SessionStart)",
        "    } else {",
        "        OutputEvent::with_context(HookEvent::SessionStart, fragments.join(\"\\n\\n\"))",
        "    }",
        "}"
      ]
    },
    {
      "rust_file": "src/hook.rs",
      "rust_item": "fn[discovery_hint]",
      "text": [
        "/// Suggest `cargo agents --help` when the active workspace exposes crate-aware plugin subcommands.",
        "/// Reuses the help renderer's `applicable_subcommands`, so the hint fires only when there is actually something to discover; `None` otherwise.",
        "// {impl}`design.requirements.hooks.discovery_hint`",
        "// {impl}`design.requirements.hooks.discovery_hint_audience`",
        "// {impl}`design.requirements.consent.unconsented_inactive`",
        "// {impl}`design.requirements.consent.consented_active`",
        "// {impl}`design.requirements.consent.dormant_inactive`",
        "// {impl}`design.requirements.consent.use_wakes_dormant`",
        "// {impl}`design.requirements.consent.offline_resolution`",
        "async fn discovery_hint(sym: &Symposium, deps: &Arc<Workspace>) -> Option<String> {",
        "    let workspace = deps.info().await.cloned();",
        "    let registry = crate::plugins::load_registry_with_workspace(sym, workspace.as_ref()).await;",
        "    let dep_ids = deps.dep_ids().await.to_vec();",
        "",
        "    let pms = deps.pms();",
        "    let used = workspace",
        "        .as_ref()",
        "        .map(|ws| crate::discovery::used_plugins(sym, pms, &registry.plugins, &ws.root))",
        "        .unwrap_or_default();",
        "    let mut ctx = crate::predicate::PredicateContext::new(&dep_ids).with_used(&used);",
        "    let active = crate::plugins::active_plugins(",
        "        sym,",
        "        &registry,",
        "        pms,",
        "        workspace.as_ref().map(|ws| ws.root.as_path()),",
        "        &mut ctx,",
        "        symposium_install::UpdateLevel::None,",
        "    )",
        "    .await;",
        "    let any_subcommand = !applicable_subcommands(&active, &dep_ids, &used).is_empty();",
        "",
        "    any_subcommand.then(|| {",
        "        format!(",
        "            \"This project has crate-aware tools available via `cargo agents`. \\",
        "             Run `cargo agents --help` to list them before working with the Rust code. \\",
        "             Only use tools under the '{AGENTS_HEADING}' section unless the user \\",
        "             explicitly asks you to run one from '{HUMANS_HEADING}'.\"",
        "        )",
        "    })",
        "}"
      ]
    },
    {
      "rust_file": "tests/hook_agent.rs",
      "rust_item": "fn[session_start_hints_discovery_when_subcommands_apply]",
      "text": [
        "/// In a workspace with crate-aware plugin subcommands, SessionStart nudges the",
        "/// agent to discover them via `cargo agents --help`.",
        "#[tokio::test]",
        "async fn session_start_hints_discovery_when_subcommands_apply() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"help_render0\"],",
        "        async |mut ctx| {",
        "            // Keep the update path dormant so only the discovery hint is asserted.",
        "            ctx.sym.config.auto_update = symposium::config::AutoUpdate::Off;",
        "",
        "            let result = ctx",
        "                .prompt_or_hook(\"hello\", &[HookStep::session_start()], HookAgent::Claude)",
        "                .await?;",
        "",
        "            let context = result",
        "                .hooks",
        "                .iter()",
        "                .filter_map(|h| {",
        "                    let top = h.output.get(\"additionalContext\").and_then(|v| v.as_str());",
        "                    let nested = h",
        "                        .output",
        "                        .get(\"hookSpecificOutput\")",
        "                        .and_then(|o| o.get(\"additionalContext\"))",
        "                        .and_then(|v| v.as_str());",
        "                    top.or(nested)",
        "                })",
        "                .next()",
        "                .expect(\"session-start should produce additionalContext\");",
        "",
        "            expect_test::expect![[r#\"This project has crate-aware tools available via `cargo agents`. Run `cargo agents --help` to list them before working with the Rust code. Only use tools under the 'Commands for agents' section unless the user explicitly asks you to run one from 'Commands for humans'.\"#]]",
        "                .assert_eq(context);",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    }
  ],
  "rationale": "**Holds.** `dispatch_builtin` routes `SessionStart` to `handle_session_start`, which includes `discovery_hint`. `discovery_hint` builds the active plugin set (`plugins::active_plugins` over the registry, with workspace deps and `use` names) and returns the hint only when `subcommand_dispatch::applicable_subcommands` is non-empty. The text says \"Run `cargo agents --help` to list them\". Fragments are joined into the `SessionStart` context.\n\n**Test:** `tests/hook_agent.rs::session_start_hints_discovery_when_subcommands_apply` (fixture `help_render0`, auto-update off) asserts the exact context string with `expect_test`. Passes. The negative case (no subcommands, no hint) has no dedicated test here; judged from code (`any_subcommand.then(..)`).\n",
  "requirement": "On `SessionStart`, when the workspace exposes applicable plugin subcommands, Symposium MUST add context telling the agent to run `cargo agents --help`."
}
