        "                    .unwrap_or_else(|e| panic!(\"{agent:?} stdout is not JSON ({e}): {stdout}\"));",
        "            }",
        "        }",
        "        Ok(())",
        "    })",
        "    .await",
        "    .unwrap();",
        "}"
