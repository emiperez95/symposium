        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"plugin-hook-decisions0\"],",
        "        async |ctx| {",
        "            let cwd = ctx.tempdir.display().to_string();",
        "            let cases = [",
        "                (",
        "                    HookAgent::Kiro,",
        "                    \"pre-tool-use\",",
        "                    tool_call(\"DenyProbe\"),",
        "                    DENY_REASON,",
        "                ),",
        "                (",
        "                    HookAgent::Claude,",
        "                    \"user-prompt-submit\",",
