    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[plugins_entries_match_crate_names_like_cargo]",
      "text": [
        "/// A crate name matches the way cargo matches it, so `crate_a` names the",
        "/// dependency `crate-a` in `auto-enable`, `use` and `disable` alike.",
        "// {test}`design.requirements.consent.crate_name_matching`",
        "// {test}`design.requirements.consent.consented_active`",
        "// {test}`design.requirements.consent.disable_wins`",
        "#[tokio::test]",
        "async fn plugins_entries_match_crate_names_like_cargo() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let skills_dir = ctx.workspace_root.clone().unwrap().join(\".claude/skills\");",
        "            let installed = || !find_installed_skills(&skills_dir, \"a-guidance\").is_empty();",
        "",
        "            ctx.sym.config.plugins.auto_enable = vec![\"crate_a\".into()];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(installed(), \"auto-enable\");",
        "",
        "            ctx.sym.config.plugins.auto_enable.clear();",
        "            ctx.sym.config.plugins.used = vec![UseEntry::Global(\"crate_a\".into())];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(installed(), \"use\");",
        "",
        "            ctx.sym.config.plugins.used.clear();",
        "            ctx.sym.config.plugins.auto_enable = vec![\"*\".into()];",
        "            ctx.sym.config.plugins.disable = vec![\"crate_a\".into()];",
        "            ctx.symposium(&[\"sync\"]).await?;",
        "            assert!(!installed(), \"disable\");",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    },
    {
      "rust_file": "tests/enablement.rs",
      "rust_item": "fn[status_lists_each_declined_name_once]",
      "text": [
        "// {test}`design.requirements.consent.crate_name_matching`",
        "// {test}`design.requirements.enablement.status_once`",
        "// {test}`design.requirements.enablement.status_state`",
        "#[tokio::test]",
        "async fn status_lists_each_declined_name_once() {",
        "    with_fixture(",
        "        TestMode::SimulationOnly,",
        "        &[\"auto-enable0\"],",
        "        async |mut ctx| {",
        "            ctx.symposium(&[\"init\", \"--add-agent\", \"claude\"]).await?;",
        "            let workspace_root = ctx.workspace_root.clone().unwrap();",
        "            ctx.sym.config.plugins.disable = [\"crate_a\", \"*\", \"never-seen\", \"never_seen\"]",
        "                .map(String::from)",
        "                .to_vec();",
        "",
        "            let deps = ctx.sym.workspace(&workspace_root);",
        "            let entries = symposium::status_command::workspace_status(&ctx.sym, &deps).await?;",
        "            let named = |name: &str| {",
        "                entries",
        "                    .iter()",
        "                    .filter(|e| e.name.replace('_', \"-\") == name)",
        "                    .collect::<Vec<_>>()",
        "            };",
        "",
        "            let crate_a = named(\"crate-a\");",
        "            assert_eq!(crate_a.len(), 1, \"{entries:?}\");",
        "            assert_eq!(crate_a[0].state, StatusState::Declined);",
        "            assert_eq!(crate_a[0].version.as_deref(), Some(\"0.1.0\"));",
        "            assert!(named(\"*\").is_empty(), \"{entries:?}\");",
        "            // No package manager has `never-seen`, so nothing says the two",
        "            // spellings are one package.",
        "            let never_seen = named(\"never-seen\");",
        "            assert_eq!(never_seen.len(), 2, \"{entries:?}\");",
        "            assert!(never_seen.iter().all(|e| e.state == StatusState::Declined));",
        "            Ok(())",
        "        },",
        "    )",
        "    .await",
        "    .unwrap();",
        "}"
      ]
    }
  ],
  "rationale": "All `[plugins]` matching goes through `config::name_matches`, which compares `pms.identity(..)` of the entry and the id; for a cargo id the owner is `CargoPm`, whose `canonical_name` is `normalize_crate_name` (`-` -> `_`). This covers `is_auto_enabled`, `is_disabled`, `is_used_in`. `use` names are resolved by `PmRegistry::identify` -> `PmInstance::find` (compares `canonical_name`) and the result is mapped to `identity`, so `enabled_dependencies` compares `used == pms.identity(id)` and `decide` compares `used.contains(&pms.identity(id))` in folded form. `enabled_dependencies`' `known` set holds identities too, so differing spellings don't double-enable.\n\nTests (all pass): `discovery::tests::auto_enable_moves_a_candidate_to_enabled` (`auto-enable = [\"widget_lib\"]` enables `widget-lib`); `tests/enablement.rs` `plugins_entries_match_crate_names_like_cargo` (`crate_a` in auto-enable, use and disable each match `crate-a`), `use_records_workspace_entry_and_installs` and `use_global_records_unscoped_entry` (`use crate_a` after `use crate-a` does not add an entry), `status_lists_each_declined_name_once` (`disable = [\"crate_a\"]` reports `crate-a` declined once).",
  "requirement": "Symposium MUST treat hyphens and underscores as equal when it compares a `[plugins]` or `cargo agents use` name with a cargo crate name."
}
